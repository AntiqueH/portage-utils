libqcurl.a: $(libqcurl_a_OBJECTS) $(libqcurl_a_DEPENDENCIES) $(EXTRA_libqcurl_a_DEPENDENCIES) 
	$(AM_V_at)-rm -f libqcurl.a
	$(AM_V_AR)$(libqcurl_a_AR) libqcurl.a $(libqcurl_a_OBJECTS) $(libqcurl_a_LIBADD)
	$(AM_V_at)$(libqcurl_a_RANLIB) libqcurl.a

mostlyclean-compile:
	-rm -f *.$(OBJEXT)
	-rm -f lib/*.$(OBJEXT)
	-rm -f lib/curlx/*.$(OBJEXT)
	-rm -f lib/vauth/*.$(OBJEXT)
	-rm -f lib/vquic/*.$(OBJEXT)
	-rm -f lib/vssh/*.$(OBJEXT)
	-rm -f lib/vtls/*.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

