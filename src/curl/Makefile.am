# Vendored libcurl 8.20.0: lib/ + include/curl/ taken verbatim from
# curl-8.20.0.tar.xz (nothing else of the curl distribution is used).
# It is compiled as part of the regular build, like libq -- no separate
# curl build system involved.
#
# lib/curl_config.h was generated by running curl's own configure on
# the target system with only HTTP(S), OpenSSL and zlib enabled:
#   configure --disable-shared --enable-static --with-openssl \
#     --with-zlib --without-libpsl --without-nghttp2 --without-brotli \
#     --without-zstd --without-libidn2 --without-libssh2 \
#     --disable-ftp --disable-file --disable-ldap --disable-ldaps \
#     --disable-rtsp --disable-dict --disable-telnet --disable-tftp \
#     --disable-pop3 --disable-imap --disable-smb --disable-smtp \
#     --disable-gopher --disable-mqtt --disable-ipfs --disable-manual \
#     --disable-docs --disable-libcurl-option --disable-ntlm \
#     --disable-tls-srp --disable-ares
#
# To upgrade: replace lib/ and include/curl/ with the new release's,
# re-run the configure line above, copy the fresh lib/curl_config.h,
# and regenerate the source list below from lib/Makefile.inc.
