	-rm -f ./$(DEPDIR)/fuzz_gpkg_manifest.Po
	-rm -f ./$(DEPDIR)/fuzz_gpkg_structure.Po
	-rm -f ./$(DEPDIR)/fuzz_hash.Po
	-rm -f ./$(DEPDIR)/fuzz_mfline.Po
	-rm -f ./$(DEPDIR)/fuzz_moves.Po
	-rm -f ./$(DEPDIR)/fuzz_needed.Po
	-rm -f ./$(DEPDIR)/fuzz_packages.Po
	-rm -f ./$(DEPDIR)/fuzz_preserved.Po
	-rm -f ./$(DEPDIR)/fuzz_usedep.Po
	-rm -f ./$(DEPDIR)/fuzz_useflags.Po
	-rm -f ./$(DEPDIR)/fuzz_xpak.Po
	-rm -f ./$(DEPDIR)/main.Po
	-rm -f Makefile
distclean-am: clean-am distclean-compile distclean-generic \
	distclean-tags

