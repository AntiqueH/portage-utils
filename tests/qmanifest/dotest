#!/bin/bash

# doesn't run under GitHub Actions with valgrind at the moment
[[ ${GITHUB_JOB} == valgrind ]] && exit 0

. ../init.sh || exit 1

set -e

export ROOT=${as}/root
export PORTAGE_CONFIGROOT=${as}/root

mktmpdir

# regression #3: a metadata/layout.conf larger than parse_layout_conf's
# 8192-byte read buffer must be compacted between reads without reading
# past that stack buffer.  Verifying the tree runs parse_layout_conf over
# the >8192 fixture; the asan+ubsan gate is the enforcer (pre-fix this
# aborts with a stack-buffer-overflow in parse_layout_conf).
rm -rf bigtree
cp -r "${as}/root/bigtree" bigtree
out=$(qmanifest bigtree 2>&1 || :)
if grep -qiE "AddressSanitizer|runtime error|buffer-overflow" <<< "${out}" ; then
	rc=1
else
	rc=0
fi
tend $rc "layout.conf > 8192 parsed without OOB (parse_layout_conf)"

# testing regression with manifest-hashes in a bigger than 8192 layout.conf
# that has no '=' trailing. we somehow found this with asan tests via qmanifest.c
rm -rf bigtree7
mkdir -p bigtree7/metadata
awk 'BEGIN {
	n = 0;
	while (n < 8100) {
		line = "# aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
		print line; n += length(line) + 1;
	}
	print "manifest-hashes";           # malformed: no "="
	for (i = 0; i < 60; i++) print "bbbb";   # filler past 8192, no "="
}' > bigtree7/metadata/layout.conf
out=$(qmanifest bigtree7 2>&1 || :)
if grep -qiE "AddressSanitizer|runtime error|buffer-overflow" <<< "${out}" ; then
	rc=1
else
	rc=0
fi
tend $rc "malformed manifest-hashes in >8192 layout.conf parsed without OOB"

test() {
	local num=$1 exp=$2 ret=0
	shift 2
	eval "$*" > manifest 2>&1 || ret=$?
	sed -i -e '/^checked [0-9]/s/ in [0-9.]\+s$//' manifest
	if ! diff -u ${as}/manifest${num}.good manifest; then
		tfail "output does not match"
		[[ -e gpgme.log ]] && cat gpgme.log
	fi
	if [[ ${exp} -ne ${ret} ]] ; then
		tfail "exit code (${ret}) does not match expected (${exp}) for test ${num} (args: $*)"
	fi
	tend $? "$*"
}

# verify we see our overlays
DEBUG=1 q -ev
test 00 0 "q -o"

# simple run check (should do bad_tree)
test 01 2 "qmanifest"

# match overlay
test 02 2 "qmanifest not_a_tree"

# match dir
test 03 2 "qmanifest notatree"

# dir test
test 04 1 "qmanifest -d not_a_tree"

# overlay test
test 05 1 "qmanifest -o notatree"

# generate a valid tree
rm -Rf testtree
cp -r "${ROOT}/simpletree" testtree || echo try it anyway
export HOME=${PWD}  # for gpgme/gnupg home
export GNUPGHOME=${PWD}/.gnupg
mkdir -p "${HOME}"/.gnupg
# silence gpg warnings
chmod -R og-rwx "${HOME}"/.gnupg

gpg_import() {
	local key=$1
	local pass=$2
	local args=(
		--batch
		--quiet
		--no-tty
		--passphrase-fd 0
		--pinentry-mode loopback
		--import "${key}"
	)

	echo "${pass}" | gpg "${args[@]}"
}
# import key, if this fails, skip the test, couple of reasons why this
# could fail:
# - Ubuntu uses old/ancient gnupg which doesn't grok arguments and key (Travis)
# - HOME (T) may be too long to hold a socket, especially on Linux this
#   pathlength is very short, Portage's T may be too long by default
# valgrind really messes with gpgme, and the other way around, so
# unfortunately cannot run this when valgrind is active either
set +e
if [[ -z ${Q_RUN_WITH_VALGRIND} ]] && \
	gpg_import "${as}"/key.gpg qmanifest
then
set -e

tend 0 "gpg import key"

# make it a fully valid tree
rm testtree/my-cat/mypackage/unrecorded-file
# drop ROOT, we'll work here in T
unset ROOT PORTAGE_CONFIGROOT
SIGNAS=0x3D695C8C0F87966B62DC5AFCDCFABA8E07F52261
KEYPASS=qmanifest
export GPGME_DEBUG=9:${PWD}/gpgme.log
rm -f gpgme.log
test 06 0 "qmanifest -g -s ${SIGNAS} -p testtree <<< ${KEYPASS}"

# validate the just generated tree
rm -f gpgme.log
test 07 0 "qmanifest testtree | sed -e '/Manifest timestamp/d' -e 's/made .* UTC by/made by/'"

# regression time. a empty (0-byte) recorded file must be hashed and
# verified like any other, not rejected as "cannot open file!"
: > testtree/my-cat/mypackage/mypackage-3.ebuild
rm -f gpgme.log
qmanifest -g -s ${SIGNAS} -p testtree <<< ${KEYPASS} >/dev/null 2>&1 || :
vret=0
eout=$(qmanifest testtree 2>&1) || vret=$?
if [[ ${vret} -eq 0 ]] && ! grep -q "cannot open file" <<< "${eout}" ; then
	rc=0
else
	rc=1
fi
tend $rc "empty (0-byte) file verified, not 'cannot open file!'"

else
	if [[ -n ${Q_RUN_WITH_VALGRIND} ]] ; then
		echo "${WARN}SKIPPED:${NORMAL} qmanifest gpg checks (valgrind active, gpgme incompatible)"
	else
		echo "${WARN}SKIPPED:${NORMAL} qmanifest gpg checks (gpg key import failed)"
	fi
fi  # gpgimport

# shut down agents and whatnot
gpgconf --kill all

cleantmpdir

end
