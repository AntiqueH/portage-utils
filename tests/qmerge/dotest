tend $? "qmerge-test: [DC] the library /bin/sh links against survives with it" \
	|| die "${outdc}"
rm -f "${ROOT}/usr/lib/libdcsh.so.1"
rm -rf "${ROOT}/usr/bin/q" "${ROOT}/bin/sh"

# shared files, a path another installed package still
# owns is left alone, a path only batch members own goes with the last of them
dc_reset
dc_vdb dc-libs/K-1 0 "" && dc_vdb dc-libs/X-1 0 "" && dc_vdb dc-libs/Y-1 0 ""
dc_world dc-libs/K
echo shared > "${ROOT}/usr/share/dc/kx-shared"
echo shared > "${ROOT}/usr/share/dc/xy-shared"
dcmd=$(md5sum "${ROOT}/usr/share/dc/kx-shared" | cut -d' ' -f1)
echo "obj /usr/share/dc/kx-shared ${dcmd} 1" >> "${ROOT}/var/db/pkg/dc-libs/K-1/CONTENTS"
echo "obj /usr/share/dc/kx-shared ${dcmd} 1" >> "${ROOT}/var/db/pkg/dc-libs/X-1/CONTENTS"
echo "obj /usr/share/dc/xy-shared ${dcmd} 1" >> "${ROOT}/var/db/pkg/dc-libs/X-1/CONTENTS"
echo "obj /usr/share/dc/xy-shared ${dcmd} 1" >> "${ROOT}/var/db/pkg/dc-libs/Y-1/CONTENTS"
rm -rf "${ROOT}/dclog"; mkdir -p "${ROOT}/dclog"
outdc=$(yes | env EMERGE_LOG_DIR="${ROOT}/dclog" qmerge -c 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 && $(echo "${outdc}" | dc_sel) == "dc-libs/X-1 dc-libs/Y-1" ]]
tend $? "qmerge-test: [DC] shared files: both orphans selected and removed" \
	|| die "rc=${rcdc} ${outdc}"
# emerge.log carries one "=== Unmerging..." and one "unmerge success" line
# per package, like portage, so qlop counts each removal once
[[ $(grep -c "=== Unmerging... (dc-libs/X-1)" "${ROOT}/dclog/emerge.log") -eq 1 && \
   $(grep -c "unmerge success: dc-libs/X-1" "${ROOT}/dclog/emerge.log") -eq 1 && \
