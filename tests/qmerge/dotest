q --root "${ROOT}" qmaint binhost -f >/dev/null 2>&1
tend $? "qmerge-test: [B] binhost -f regenerates index"

btafter=$(btkey)
[[ ${btbefore} != "1888888888" && ${btafter} == "1888888888" ]]
tend $? "qmerge-test: [B] index BUILD_TIME refreshed to rebuilt value" \
	|| die "before=${btbefore} after=${btafter}"

q --root "${ROOT}" qmaint binhost >/dev/null 2>&1
tend $? "qmerge-test: [B] binhost check clean after -f"

grep -q '^CPV: sys-devel/qmerge-test-1.3$' "${ROOT}/packages/Packages"
