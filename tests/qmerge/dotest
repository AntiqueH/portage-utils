	|| die "${outdc}"
rm -f "${ROOT}/usr/lib/libdcn.so.1" "${ROOT}/var/lib/portage/preserved_libs_registry"

# failing unmerge stops the whole list run like emerge does (with its status returned)
# the packages before it are gone, the ones after it remain
dc_reset
dc_vdb dc-libs/A-1 0 "dc-libs/B"
dc_vdb dc-libs/B-1 0 "dc-libs/C"
dc_vdb dc-libs/C-1 0 ""
dc_vdb dc-libs/D-1 0 ""
dc_world dc-libs/D
rm -f "${ROOT}/var/db/pkg/dc-libs/B-1/CONTENTS"
rm -rf "${ROOT}/dclog"; mkdir -p "${ROOT}/dclog"
outdc=$(yes | env EMERGE_LOG_DIR="${ROOT}/dclog" qmerge -c 2>&1); rcdc=$?
[[ ${rcdc} -ne 0 && \
   ${outdc} == *">>> Unmerging (1 of 3) dc-libs/A-1..."*">>> Unmerging (2 of 3) dc-libs/B-1..."* && \
   ${outdc} != *">>> Unmerging (3 of 3)"* && ${outdc} != *"Number removed"* ]] && \
	grep -q "unmerge FAILURE: dc-libs/B-1" "${ROOT}/dclog/emerge.log"
