qm_merged dc-libs/C-1 "[DC] failure: the package after it is untouched"
qm_merged dc-libs/D-1 "[DC] failure: the world package intact"
[[ $(cat "${ROOT}/var/lib/portage/world") == "dc-libs/D" ]]
tend $? "qmerge-test: [DC] failure: the world file unchanged" \
	|| die "$(cat "${ROOT}/var/lib/portage/world")"

# -U of several packages over one owners table (vardbapi._owners), a file
# another installed package isowner() of is "--- replaced" and stays, a file
# only the unmerged packages claim is unlinked with the last of them
dc_reset
dc_vdb dc-libs/K-1 0 "" && dc_vdb dc-libs/X-1 0 "" && dc_vdb dc-libs/Y-1 0 ""
dc_world dc-libs/K dc-libs/X dc-libs/Y
echo shared > "${ROOT}/usr/share/dc/kx-shared"
echo shared > "${ROOT}/usr/share/dc/xy-shared"
dcmd=$(md5sum "${ROOT}/usr/share/dc/kx-shared" | cut -d' ' -f1)
echo "obj /usr/share/dc/kx-shared ${dcmd} 1" >> "${ROOT}/var/db/pkg/dc-libs/K-1/CONTENTS"
echo "obj /usr/share/dc/kx-shared ${dcmd} 1" >> "${ROOT}/var/db/pkg/dc-libs/X-1/CONTENTS"
echo "obj /usr/share/dc/xy-shared ${dcmd} 1" >> "${ROOT}/var/db/pkg/dc-libs/X-1/CONTENTS"
echo "obj /usr/share/dc/xy-shared ${dcmd} 1" >> "${ROOT}/var/db/pkg/dc-libs/Y-1/CONTENTS"
outdc=$(yes | qmerge -U dc-libs/X dc-libs/Y 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 && -e ${ROOT}/usr/share/dc/kx-shared && \
   ! -e ${ROOT}/usr/share/dc/xy-shared && \
   ! -e ${ROOT}/usr/share/dc/X-1 && ! -e ${ROOT}/usr/share/dc/Y-1 ]]
tend $? "qmerge-test: [DC] -U batch: the file another package isowner() of stays, the batch's own file goes" \
	|| die "rc=${rcdc} ${outdc} $(ls -la "${ROOT}/usr/share/dc")"
qm_unmerged dc-libs/X "[DC] -U batch: X unmerged"
qm_unmerged dc-libs/Y "[DC] -U batch: Y unmerged"
qm_merged dc-libs/K-1 "[DC] -U batch: K intact including the file it still owns"
# -e (erase) consults no owners table: every CONTENTS entry is unlinked
outdc=$(yes | qmerge -e dc-libs/K 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 && ! -e ${ROOT}/usr/share/dc/kx-shared ]]
tend $? "qmerge-test: [DC] -e unlinks every recorded file, owners not consulted" \
