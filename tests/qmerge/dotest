	|| die "rc=${rcdc} ${outdc} $(ls -la "${ROOT}/etc")"
qm_unmerged dc-libs/E "[DC] config: the owner is unmerged all the same"
rm -f "${ROOT}/etc/dc.conf" "${ROOT}/etc/dc-other.conf"

# preserve-libs testing
# a library a kept package still links against is preserved on the removal,
# it's registered, and the kept package joins @preserved-rebuild
dc_reset
dc_vdb dc-libs/N-1 0 "" && dc_vdb dc-libs/S-1 0 ""
mkdir -p "${ROOT}/usr/lib"
echo lib > "${ROOT}/usr/lib/libdcn.so.1"
dcmd=$(md5sum "${ROOT}/usr/lib/libdcn.so.1" | cut -d' ' -f1)
