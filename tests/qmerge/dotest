qm_unmerged dc-libs/N "[DC] preserve-libs: the library package itself is gone"
grep -q '"dc-libs/N:0"' "${ROOT}/var/lib/portage/preserved_libs_registry" && \
	grep -q '"dc-libs/N-1"' "${ROOT}/var/lib/portage/preserved_libs_registry" && \
