[[ ${rcdc} -eq 0 && $(echo "${outdc}" | dc_sel) == "" && \
   ${outdc} == *">>> No packages selected for removal by prune"* && \
   ${outdc} == *">>> To see reverse dependencies, use "*"--verbose"* && \
   ${outdc} == *">>> To ignore dependencies, use "*"--nodeps"* && \
   ${outdc} != *"Packages installed:"* && ${outdc} != *"Number to remove"* ]]
tend $? "qmerge-test: [DC] prune: the old slot something needs stays, both hints, no summary" \
	|| die "rc=${rcdc} ${outdc}"
outdc=$(qmerge -pPv 2>&1)
