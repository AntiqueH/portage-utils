tend $? "qmerge-test: [DC] emerge.log logs each removal once" \
	|| die "$(cat "${ROOT}/dclog/emerge.log")"
[[ ${outdc} == *"<<<"*"${ROOT}/usr/share/dc/X-1"* && \
   ${outdc} != *" /usr/share/dc/X-1"* ]]
tend $? "qmerge-test: [DC] unmerge lines carry ROOT" || die "${outdc}"
qm_unmerged dc-libs/X "[DC] shared files: X unmerged"
qm_unmerged dc-libs/Y "[DC] shared files: Y unmerged"
qm_merged dc-libs/K-1 "[DC] shared files: K intact including the path X also owned"
[[ ! -e ${ROOT}/usr/share/dc/xy-shared && ! -e ${ROOT}/usr/share/dc/X-1 && \
   ! -e ${ROOT}/usr/share/dc/Y-1 ]]
tend $? "qmerge-test: [DC] shared files: the path only the batch owned is gone" \
	|| die "$(ls -la "${ROOT}/usr/share/dc")"

# fuzzing two virtuals that need each other, both wanted by one package
dc_reset
dc_vdb virtual/va-1 0 "virtual/vb"
dc_vdb virtual/vb-1 0 "virtual/va"
dc_vdb dc-libs/P-1 0 "virtual/va virtual/vb"
dc_world dc-libs/P
outdc=$(timeout 60 qmerge -pc 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 && ${outdc} == *">>> No packages selected for removal by depclean"* ]]
tend $? "qmerge-test: [DC] mutually dependent virtuals terminate and are kept" \
	|| die "rc=${rcdc} ${outdc}"

# overlapping || groups past the DNF expansion limit are kept as written,,
# with a warning, and the chooser decides each group
dc_reset
dc_vdb dc-libs/A-1 0 "" && dc_vdb dc-libs/B-1 0 ""
dcg=""; for dci in $(seq 1 13); do dcg="${dcg}|| ( >=dc-libs/A-0.${dci} dc-libs/B ) "; done
dc_vdb dc-libs/G-1 0 "${dcg}"
dc_world dc-libs/G
outdc=$(timeout 60 qmerge -pc 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 && $(echo "${outdc}" | dc_sel) == "dc-libs/B-1" && \
   ${outdc} == *"13 overlapping || groups would expand to more than 2048 combinations, keeping them as written"* ]]
tend $? "qmerge-test: [DC] DNF expansion limit keeps the groups as written" \
	|| die "rc=${rcdc} ${outdc}"

# hold the vdb lock from the first unmerge to the world file update
# 2nd qmerge started while a pkg_prerm is still running
# waits for it and remove its package only after the stuff already finished
dc_reset
dc_vdb dc-libs/W-1 0 "" && dc_vdb dc-libs/L-1 0 "" && dc_vdb dc-libs/M-1 0 ""
dc_world dc-libs/W dc-libs/M
echo prerm > "${ROOT}/var/db/pkg/dc-libs/L-1/DEFINED_PHASES"
printf 'pkg_prerm() { : > "%s/dclock-prerm"; sleep 8; }\n' "${PWD}" \
	| bzip2 > "${ROOT}/var/db/pkg/dc-libs/L-1/environment.bz2"
rm -rf "${ROOT}/dclog" "${PWD}/dclock-prerm"; mkdir -p "${ROOT}/dclog"
yes | env EMERGE_LOG_DIR="${ROOT}/dclog" qmerge -c > "${PWD}/dclock-first.out" 2>&1 &
dclockpid=$!
for dci in $(seq 1 50); do [[ -e ${PWD}/dclock-prerm ]] && break; sleep 0.2; done
outdcp=$(timeout 60 qmerge -pU dc-libs/M 2>&1); rcdcp=$?
dcpt=$(date +%s)
outdc=$(yes | env EMERGE_LOG_DIR="${ROOT}/dclog" timeout 60 qmerge -U dc-libs/M 2>&1); rcdc=$?
wait ${dclockpid}; rcdc1=$?
[[ ${rcdc1} -eq 0 && ${rcdc} -eq 0 && -e ${PWD}/dclock-prerm && \
   ${outdc} == *"waiting for vdb lock "*"/var/db/.pkg.portage_lockfile"* ]]
tend $? "qmerge-test: [DC] a second qmerge waits for the batch's vdb lock" \
	|| die "rc=${rcdc1}/${rcdc} $(cat "${PWD}/dclock-first.out") --- ${outdc}"
dclt=$(sed -n 's/^\([0-9]*\):  >>> unmerge success: dc-libs\/L-1$/\1/p' "${ROOT}/dclog/emerge.log")
dcmt=$(sed -n 's/^\([0-9]*\): === Unmerging... (dc-libs\/M-1)$/\1/p' "${ROOT}/dclog/emerge.log")
[[ -n ${dclt} && -n ${dcmt} && ${dcmt} -ge ${dclt} ]]
tend $? "qmerge-test: [DC] the waiting removal starts after the batch finished" \
	|| die "L done at '${dclt}', M started at '${dcmt}': $(cat "${ROOT}/dclog/emerge.log")"
[[ ${rcdcp} -eq 0 && ${dcpt} -lt ${dclt} && ${outdcp} == *"unmerging dc-libs/M-1"* && \
   ${outdcp} != *"waiting for"* ]]
tend $? "qmerge-test: [DC] a pretend unmerge during the batch returns at once, no lock taken" \
	|| die "rc=${rcdcp} pretend done at ${dcpt}, L done at '${dclt}': ${outdcp}"
qm_unmerged dc-libs/L "[DC] lock: the batch's package unmerged"
qm_unmerged dc-libs/M "[DC] lock: the waiting removal's package unmerged"
qm_merged dc-libs/W-1 "[DC] lock: the world package intact"
[[ ! -e ${ROOT}/var/db/.pkg.portage_lockfile ]]
tend $? "qmerge-test: [DC] lock: the lock file is unlinked on release like portage's unlockfile" \
	|| die "$(ls -la "${ROOT}/var/db")"
rm -f "${PWD}/dclock-prerm" "${PWD}/dclock-first.out"

# blockers in an installed package's RDEPEND don't keep nor break anything,
# the blocked packages are orphans
dc_reset
dc_vdb dc-libs/W-1 0 "!dc-libs/Z !!dc-libs/Q dc-libs/B"
dc_vdb dc-libs/B-1 0 "" && dc_vdb dc-libs/Z-1 0 "" && dc_vdb dc-libs/Q-1 0 ""
dc_world dc-libs/W
outdc=$(qmerge -pc 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 && $(echo "${outdc}" | dc_sel) == "dc-libs/Q-1 dc-libs/Z-1" && \
   ${outdc} != *"unsatisfied"* ]]
tend $? "qmerge-test: [DC] blocker atoms ignored, blocked orphans cleaned, dependency kept" \
	|| die "rc=${rcdc} ${outdc}"

# a modified CONFIG_PROTECT file survives the removal
# an unmodified does not survive the removal
dc_reset
dc_vdb dc-libs/W-1 0 "" && dc_vdb dc-libs/E-1 0 ""
dc_world dc-libs/W
mkdir -p "${ROOT}/etc"
