[[ ${rcdc} -ne 0 && ${outdc} == *"No packages to prune have been provided."* ]]
tend $? "qmerge-test: [DC] prune --nodeps without arguments does nothing" \
	|| die "rc=${rcdc} ${outdc}"
qm_merged dc-libs/A-1 "[DC] prune --nodeps without arguments: the old slot untouched"
outdc=$(yes | qmerge -P -O dc-libs/B 2>&1); rcdc=$?
[[ ${rcdc} -ne 0 && ${outdc} == *">>> No packages selected for removal by prune"* ]]
tend $? "qmerge-test: [DC] prune --nodeps: a single-version package selects nothing" \
	|| die "rc=${rcdc} ${outdc}"
qm_merged dc-libs/B-1 "[DC] prune --nodeps: the single version untouched"
outdc=$(yes | qmerge -P -O dc-libs/A 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 ]]
tend $? "qmerge-test: [DC] prune --nodeps: rc 0" || die "rc=${rcdc} ${outdc}"
qm_unmerged dc-libs/A-1 "[DC] prune --nodeps: the needed old slot unmerged anyway"
qm_merged dc-libs/A-2 "[DC] prune --nodeps: the best version intact"
qm_merged dc-libs/B-1 "[DC] prune --nodeps: the revdep untouched"

# without arguments and without a multi-version package the missing
# dependency block is fatal and carries the --nodeps hint
dc_reset
dc_vdb dc-libs/A-1 0 "dc-libs/missing"
dc_world dc-libs/A
outdc=$(qmerge -pP 2>&1); rcdc=$?
[[ ${rcdc} -ne 0 && \
   ${outdc} == *"Dependencies could not be completely resolved due to"* && \
   ${outdc} == *"  dc-libs/missing pulled in by:"*"    dc-libs/A-1"* && \
   ${outdc} == *"If you would like to ignore dependencies then use "*"--nodeps"* ]]
tend $? "qmerge-test: [DC] prune: unresolved dependencies abort with the --nodeps hint" \
	|| die "rc=${rcdc} ${outdc}"

# testing package moves in conjunction with -c clean and -P prune 
dc_reset
dc_vdb dc-libs/old-1 0 "" && dc_vdb dc-libs/R-1 0 "dc-libs/new"
dc_world dc-libs/R
mkdir -p "${ROOT}/mvstore" "${PWD}/cfg-dcmv/etc/portage/binrepos.conf"
printf '[mvrepo]\npriority = 1\nlocation = /mvstore\nsync-uri = http://127.0.0.1:1/\n' \
	> "${PWD}/cfg-dcmv/etc/portage/binrepos.conf/r.conf"
printf 'move dc-libs/old dc-libs/new\n' > "${ROOT}/mvstore/Moves"
outdc=$(env PORTAGE_CONFIGROOT="${PWD}/cfg-dcmv" QMERGE_MOVES=binhost-only qmerge -pc 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 && $(echo "${outdc}" | dc_sel) == "" && \
   ${outdc} == *"applied 1 package move(s)"* && \
   ${outdc} != *"could not be completely resolved"* && \
   -d ${ROOT}/var/db/pkg/dc-libs/new-1 && ! -d ${ROOT}/var/db/pkg/dc-libs/old-1 ]]
tend $? "qmerge-test: [DC] a pending package move is applied before the depclean calculation" \
	|| die "rc=${rcdc} $(ls "${ROOT}/var/db/pkg/dc-libs" 2>&1) ${outdc}"
outdc=$(env PORTAGE_CONFIGROOT="${PWD}/cfg-dcmv" QMERGE_MOVES=binhost-only qmerge -pc 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 && ${outdc} != *"applied "*"package move"* ]]
tend $? "qmerge-test: [DC] an already applied move is not applied twice" || die "rc=${rcdc} ${outdc}"
rm -rf "${ROOT}/mvstore" "${PWD}/cfg-dcmv"

dc_reset
rm -rf "${ROOT}/var/db/pkg"; cp -a "${dc_saved}" "${ROOT}/var/db/pkg"; rm -rf "${dc_saved}"
printf '%s\n' "${dc_world_saved}" > "${ROOT}/var/lib/portage/world"


cleantmpdir

set -e

end
