[[ $(stat -c %Y "${ROOT}/packages/Packages") == "${bts}" ]]
tend $? "qmerge-test: [B] index file mtime equals TIMESTAMP" \
	|| die "ts=${bts} mtime=$(stat -c %Y "${ROOT}/packages/Packages")"

FEATURES="${FEATURES} compress-index" \
