outdc=$(FEATURES="${PLFEAT}" qmerge -v --list-set @preserved-rebuild 2>&1)
[[ ${outdc} == *"holding dc-libs/S"* ]]
tend $? "qmerge-test: [DC] preserve-libs: the kept revdep is a @preserved-rebuild candidate" \
