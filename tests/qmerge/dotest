#!/bin/bash

# check family label special decoder for our tests:
#   [N] [R] [U] [C]  basic merge / re-emerge / update+unmerge / pkg_* phase order
#   [R2] [R3]        config-protect re-emerge rounds (._cfg offer, confmem)
#   [RM]             CONFIG_PROTECT_MASK creates a path back out of CONFIG_PROTECT
#   [B]              binhost index maintenance (qmaint binhost, TIMESTAMP)
#   [B-dir] [B-file] [B-symdir] [B-escape]  merge over dir / file blocker /
#                    symlink-to-dir / escaping symlink
#   [DC]             depclean: keep graph, clean list, removal order, lib-check
#   [DS]             --deselect
#   [DV]             multi-binhost priority selection
#   [E]              env-update
#   [F]              -F force install
#   [FWF]             file-with-file: installed pkg vs independently-unpacked payload
#   [FW]             QFETCH_WRAPPER/FETCH_WRAPPER fetch-command wrapping
#   [IN]             --info
#   [IV]             invalid-binpkg refusal (missing CATEGORY/PF/SLOT metadata)
#   [IX]             qmerge -i (index a hand-copied binpkg)
#   [KG]             --keep-going
#   [M]              INSTALL_MASK
#   [MI]             multi-instance builds (BUILD_ID)
#   [MU]             multiple-package upgrade in one operation
#   [NP]             --no-phases
#   [NR]             -n --noreplace
#   [PA]             package-level unmask admission
#   [PB]             verbose "pulled in by"
#   [PI]             pin identity (merged instance = recorded instance)
#   [PL]             preserved-libs (registry, eater-graph GC)
#   [qpkg]           quickpkg-builder output parity
#   [Q]              quiet output levels
#   [RN]             rejected-newer footer
#   [S]              binpkg-respect-use (lenient/strict)
#   [SO]             slot operator (:= bindings)
#   [SR]             search
#   [SU]             slot unification
#   [SW]             soname sweep
#   [TB]             tbz2 builder (libarchive, no external tar)
#   [UE]             USE_EXPAND group resolution
#   [W]              index fetch/TTL + world tools
#   [X]              compression roundtrips
#   [XC]             --exclude
#   [wtf]            world-file favorites after success/failure

. ../init.sh || exit 1

set -e

unset CONFIG_PROTECT CONFIG_PROTECT_MASK EPREFIX

export QMERGE=1
export FEATURES='config-protect-if-modified'

mktmpdir

export ROOT=${PWD}/root
export PORTAGE_TMPDIR=${PWD}
export Q_VDB=/var/db/pkg
export PKGDIR=/packages

mkdir -p "${ROOT}/var/db/pkg"

# copy packages into the ROOT
cp -a "${as}/packages" "${ROOT}/"

set +e

# sanity check on environment
q -ev
qlist -kIv

# post-success verification helpers
# we're making sure we have no false positives
qm_merged() {
	# $1 vdb path fragment (cat/pn-ver)  $2 label
	local v t p m rest bad=0
	v=$(echo "${ROOT}/var/db/pkg/$1"*)
	if [[ ! -d ${v} || ! -s ${v}/CONTENTS ]] ; then
		false; tend $? "qmerge-test: $2 (no vdb entry or empty CONTENTS)"
		return
	fi
	while read -r t p m rest ; do
		[[ ${t} == obj ]] || continue
		[[ -e ${ROOT}${p} ]] || { bad=1; break; }
	done < "${v}/CONTENTS"
	[[ ${bad} -eq 0 ]]
	tend $? "qmerge-test: $2" || die "$(cat "${v}/CONTENTS" 2>&1)"
}

 # $1 cat/pn  $2 label
qm_unmerged() {
	[[ -z $(qlist -Iv 2>/dev/null | grep "$1") ]]
	tend $? "qmerge-test: $2" || die "$(qlist -Iv 2>&1)"
}

# finally we can search like real professionals.
# search: version-aware atom keys and --exact atom for precision

out=$(qmerge -s qmerge-test-1 2>&1)
[[ ${out} == *"qmerge-test-1.3"* && ${out} != *"qmerge-test-2.0"* ]]
tend $? "qmerge-test: [SR] name-ver key selects the 1.x instance" || die "${out}"

out=$(qmerge -s qmerge-test-9 2>&1)
rc=$?
[[ ${rc} -ne 0 && ${out} == *"no matching packages"* ]]
tend $? "qmerge-test: [SR] name-ver key misses absent version" || die "${out}"

out=$(qmerge -s '>qmerge-test-1.3' 2>&1)
[[ ${out} == *"qmerge-test-2.0"* && ${out} != *"qmerge-test-1.3"* ]]
tend $? "qmerge-test: [SR] operator key" || die "${out}"

out=$(qmerge -s qmerge-test:0 2>&1)
[[ ${out} == *"qmerge-test-2.0"* ]]
tend $? "qmerge-test: [SR] slot key (index default slot 0)" || die "${out}"

out=$(qmerge -s qmerge-test:9 2>&1)
rc=$?
[[ ${rc} -ne 0 && ${out} == *"no matching packages"* ]]
tend $? "qmerge-test: [SR] slot key misses wrong slot" || die "${out}"

out=$(qmerge -s test 2>&1)
[[ ${out} == *"qmerge-test-2.0"* ]]
tend $? "qmerge-test: [SR] plain key stays a substring regex" || die "${out}"

out=$(qmerge -s 'qmerge-t.st' 2>&1)
[[ ${out} == *"qmerge-test-2.0"* ]]
tend $? "qmerge-test: [SR] regex metachars keep the regex path" || die "${out}"

out=$(qmerge --exact -s test 2>&1)
rc=$?
[[ ${rc} -ne 0 && ${out} == *"no matching packages"* ]]
tend $? "qmerge-test: [SR] --exact rejects substring key" || die "${out}"

out=$(qmerge --exact -s qmerge-test 2>&1)
tend $? "qmerge-test: [SR] --exact whole-name match" || die "${out}"

# dDo a merge into an empty tree.

out=$(yes | qmerge -F qmerge-test-1.3)
tend $? "qmerge-test: [N] basic merge" || die "${out}"

[[ ${out} != *"FAIL"* ]]
tend $? "qmerge-test: [N] no FAIL messages" || die "${out}"

order=$(echo "${out}" | awk '$1 == "@@@" && $2 ~ /^pkg_/ { printf "%s ", $NF }')
[[ ${order} == "pkg_pretend pkg_setup pkg_preinst pkg_postinst " ]]
tend $? "qmerge-test: [N] pkg_* order of execution" || die "$(printf 'got: %s\n%s\n' "${order}" "${out}")"

ran=$(echo "${out}" | grep -o 'FUNC = pkg_[a-z]*' | sed -e 's/FUNC = //' | tr '\n' ' ')
[[ ${ran} == "${order}" ]]
tend $? "qmerge-test: [N] each pkg_* body actually executed" \
	|| die "$(printf 'ran: %s\norder: %s\n%s\n' "${ran}" "${order}" "${out}")"

ls -d "${ROOT}"/var/db/pkg/sys-devel/qmerge-test-* >/dev/null
tend $? "qmerge-test: [N] vdb installed"

[[ -x ${ROOT}/usr/bin/qmerge-test && \
   -f ${ROOT}/etc/some.conf && \
   -f ${ROOT}/etc/another.conf ]]
tend $? "qmerge-test: [N] installed expected files" || die "$(treedir "${ROOT}")"

nvdb=$(echo "${ROOT}"/var/db/pkg/sys-devel/qmerge-test-1.3*)
[[ $(cat "${ROOT}/usr/bin/qmerge-test") == $'#!/bin/sh\necho hi' && \
   $(cat "${ROOT}/usr/bin/dummy") == $'#!/bin/sh\necho dummy' && \
   $(cat "${ROOT}/etc/some.conf") == $'# file conf\nfoo' ]]
tend $? "qmerge-test: [N] merged payload byte-correct" || die "$(treedir "${ROOT}")"

[[ $(awk '$1 == "obj" && $2 == "/usr/bin/qmerge-test" { print $3 }' \
	"${nvdb}/CONTENTS") == \
   $(md5sum "${ROOT}/usr/bin/qmerge-test" | cut -d' ' -f1) && \
   $(awk '$1 == "obj" && $2 == "/usr/bin/dummy" { print $3 }' \
	"${nvdb}/CONTENTS") == \
   $(md5sum "${ROOT}/usr/bin/dummy" | cut -d' ' -f1) ]]
tend $? "qmerge-test: [N] CONTENTS digests match the merged bytes" \
	|| die "$(cat "${nvdb}/CONTENTS")"

# now do a re-emerge.
out=$(yes | qmerge -F "<qmerge-test-2")
tend $? "qmerge-test: [R] re-emerge" || die "${out}"

[[ -x ${ROOT}/usr/bin/qmerge-test ]]
tend $? "qmerge-test: [R] installed expected files" || die "$(treedir "${ROOT}")"

order=$(echo "${out}" | awk '$1 == "@@@" && $2 ~ /^pkg_/ { printf "%s ", $NF }')
# PMS 9.2
[[ ${order} == "pkg_pretend pkg_setup pkg_preinst pkg_prerm pkg_postrm pkg_postinst " ]]
tend $? "qmerge-test: [R] pkg_* order of execution" || die "$(printf 'got: %s\n%s\n' "${order}" "${out}")"

ran=$(echo "${out}" | grep -o 'FUNC = pkg_[a-z]*' | sed -e 's/FUNC = //' | tr '\n' ' ')
[[ ${ran} == "${order}" ]]
tend $? "qmerge-test: [R] each pkg_* body actually executed" \
	|| die "$(printf 'ran: %s\norder: %s\n%s\n' "${ran}" "${order}" "${out}")"

[[ $(awk '$1 == "obj" && $2 == "/usr/bin/qmerge-test" { print $3 }' \
	"$(echo "${ROOT}"/var/db/pkg/sys-devel/qmerge-test-1.3*)/CONTENTS") == \
   $(md5sum "${ROOT}/usr/bin/qmerge-test" | cut -d' ' -f1) && \
   -e ${ROOT}/usr/bin/dummy ]]
tend $? "qmerge-test: [R] CONTENTS re-recorded, shared file kept" \
	|| die "$(treedir "${ROOT}")"


[[ -x ${ROOT}/usr/bin/qmerge-test && \
   -f ${ROOT}/etc/some.conf && \
   -f ${ROOT}/etc/another.conf && \
   ! -f ${ROOT}/etc/._cfg0000_some.conf ]]
tend $? "qmerge-test: [R] re-installed expected files" || die "$(treedir "${ROOT}")"

echo modified-by-admin > "${ROOT}/etc/some.conf"
out=$(yes | qmerge -F "<qmerge-test-2")
tend $? "qmerge-test: [R2] re-emerge over modified config" || die "${out}"

[[ -f ${ROOT}/etc/._cfg0000_some.conf ]]
tend $? "qmerge-test: [R2] modified config offered as ._cfg" || die "$(treedir "${ROOT}")"

out=$(yes | qmerge -F "<qmerge-test-2")
tend $? "qmerge-test: [R3] re-emerge again" || die "${out}"

[[ ! -f ${ROOT}/etc/._cfg0001_some.conf ]]
tend $? "qmerge-test: [R3] no repeated ._cfg offer (confmem)" || die "$(treedir "${ROOT}")"

# [RM] CONFIG_PROTECT_MASK priority over CONFIG_PROTECT
# we do some tiny tests to make sure CONFIG_PROTECT_MASK is doing good.
rm -f "${ROOT}"/etc/._cfg*_some.conf
echo modified-by-admin > "${ROOT}/etc/some.conf"
out=$(yes | CONFIG_PROTECT=/etc CONFIG_PROTECT_MASK=/etc/some.conf \
	qmerge -F "<qmerge-test-2" 2>&1)
tend $? "qmerge-test: [RM] re-emerge with a masked config path" || die "${out}"

[[ ! -e ${ROOT}/etc/._cfg0000_some.conf ]]
tend $? "qmerge-test: [RM] masked path not offered as ._cfg" || die "$(treedir "${ROOT}")"
[[ $(cat "${ROOT}/etc/some.conf" 2>/dev/null) == $'# file conf\nfoo' ]]
tend $? "qmerge-test: [RM] masked config overwritten in place" \
	|| die "$(cat "${ROOT}/etc/some.conf" 2>&1)"
qm_merged "sys-devel/qmerge-test-1.3" \
	"[RM] whole package still merged after masked re-emerge"
[[ $(cat "${ROOT}/etc/another.conf" 2>/dev/null) == $'# file conf\nfoo' && \
   ! -e ${ROOT}/etc/._cfg0000_another.conf ]]
tend $? "qmerge-test: [RM] sibling protected config intact, no stray sidecar" \
	|| die "$(treedir "${ROOT}")"

# upgrade to latest version

uvold=$(echo "${ROOT}"/var/db/pkg/sys-devel/qmerge-test-1.3*)
uvcount=$(cat "${uvold}/COUNTER" 2>/dev/null)
uvmd5=$(cat "${uvold}/BINPKGMD5" 2>/dev/null)
uvkeys=$(cd "${uvold}" && ls | sed -e 's/^qmerge-test-.*\.ebuild$/EBUILD/' \
	| LC_ALL=C sort | tr '\n' ' ')

out=$(yes | qmerge -F qmerge-test)
tend $? "qmerge-test: [U] update" || die "${out}"

[[ $(qlist -Iv qmerge-test) == "sys-devel/qmerge-test-2.0" ]]
tend $? "qmerge-test: qlist does not report version 2.0 installed" || die "$(qlist -Iv qmerge-test;qlist -kIv) ${out}"

[[ ! -x ${ROOT}/usr/bin/qmerge-test ]]
tend $? "qmerge-test: binary from version 1 does not exist" || die "$(treedir "${ROOT}")"
[[ -x ${ROOT}/usr/bin/qmerge-test2 ]]
tend $? "qmerge-test: binary from version 2 exists" || die "$(treedir "${ROOT}")"

uvnew=$(echo "${ROOT}"/var/db/pkg/sys-devel/qmerge-test-2.0*)
[[ $(ls -d "${ROOT}"/var/db/pkg/sys-devel/qmerge-test-* | wc -l) -eq 1 && \
   -d ${uvnew} && ! -d ${uvold} ]]
tend $? "qmerge-test: [U] vdb delta: old instance replaced, not accumulated" \
	|| die "$(ls -d "${ROOT}"/var/db/pkg/sys-devel/* 2>&1)"

uvexp="BINPKGMD5 BUILD_TIME CATEGORY CBUILD CFLAGS CHOST CONTENTS COUNTER \
CXXFLAGS DEFINED_PHASES DESCRIPTION EAPI EBUILD FEATURES HOMEPAGE INSTALL_MASK \
IUSE KEYWORDS LDFLAGS LICENSE PF SIZE SLOT USE environment.bz2 metadata repository"
uvexp=$(printf '%s\n' ${uvexp} | LC_ALL=C sort | tr '\n' ' ')
uvkeys2=$(cd "${uvnew}" && ls | sed -e 's/^qmerge-test-.*\.ebuild$/EBUILD/' \
	| LC_ALL=C sort | tr '\n' ' ')
[[ ${uvkeys2} == "${uvexp}" && ${uvkeys} == "${uvexp}" ]]
tend $? "qmerge-test: [U] vdb key set is exactly the portage-compatible set" \
	|| die "$(printf 'expected: %s\nbefore:   %s\nafter:    %s\n' "${uvexp}" "${uvkeys}" "${uvkeys2}")"

[[ $(cat "${uvnew}/COUNTER") =~ ^[0-9]+$ && \
   $(cat "${uvnew}/COUNTER") -gt ${uvcount:-0} && \
   $(cat "${uvnew}/BINPKGMD5") != "${uvmd5}" && \
   $(cat "${uvnew}/CATEGORY") == "sys-devel" && \
   $(cat "${uvnew}/SLOT") == "0" ]]
tend $? "qmerge-test: [U] vdb fields updated: COUNTER advanced, provenance re-recorded" \
	|| die "counter ${uvcount} -> $(cat "${uvnew}/COUNTER" 2>&1); md5 ${uvmd5} -> $(cat "${uvnew}/BINPKGMD5" 2>&1)"

# Finally do an unmerge.

echo alkdsjfalksdf > "${ROOT}/etc/some.conf"

rm -f "${ROOT}/etc/"._cfg*_some.conf
out=$(yes | qmerge -FU qmerge-test)
tend $? "qmerge-test: [C] uninstall" || die "${out}"

order=$(echo "${out}" | awk '$1 == "@@@" { printf "%s ", $NF }')
[[ ${order} == "pkg_prerm pkg_postrm " ]]
tend $? "qmerge-test: [C] pkg_* order of execution" || die "$(printf '%s\n' "${order}" "${out}")"

ran=$(echo "${out}" | grep -o 'FUNC = pkg_[a-z]*' | sed -e 's/FUNC = //' | tr '\n' ' ')
[[ ${ran} == "${order}" ]]
tend $? "qmerge-test: [C] each pkg_* body actually executed" \
	|| die "$(printf 'ran: %s\norder: %s\n%s\n' "${ran}" "${order}" "${out}")"

[[ ! -x ${ROOT}/usr/bin/qmerge-test && \
     -f ${ROOT}/etc/some.conf && \
   ! -f ${ROOT}/etc/another.conf && \
   ! -d ${ROOT}/var/db/pkg/sys-devel ]]
tend $? "qmerge-test: [C] uninstalled expected files" || die "$(treedir "${ROOT}")"

# cleanup
rm -Rf "${ROOT}"/etc

# successful installation trial by checks
# we designed this one to test specific archives and once unpacked
# we make sure the unpacked files match the installed files
# artificially by regular commands

ffpkg="${ROOT}/packages/sys-devel/qmerge-test-1.3.tbz2"
rm -rf ffref
mkdir -p ffref
( cd ffref && qtbz2 -s "${ffpkg}" >/dev/null 2>&1 && \
	tar xpjf qmerge-test-1.3.tar.bz2 && \
	rm -f qmerge-test-1.3.tar.bz2 qmerge-test-1.3.xpak )
[[ -s ffref/usr/bin/qmerge-test && -s ffref/etc/some.conf ]]
tend $? "qmerge-test: [FWF] payload unpacked independently and retained" \
	|| die "$(find ffref 2>&1)"

out=$(yes | qmerge -F qmerge-test-1.3 2>&1)
tend $? "qmerge-test: [FWF] install for file-with-file compare" || die "${out}"

ffbad=""
while IFS= read -r ffp ; do
	ffrel=${ffp#ffref/}
	ffdst="${ROOT}/${ffrel}"
	if [[ -L ${ffp} ]] ; then
		[[ -L ${ffdst} && \
		   $(readlink "${ffp}") == "$(readlink "${ffdst}")" ]] \
			|| ffbad+="symlink:${ffrel} "
	elif [[ -d ${ffp} ]] ; then
		[[ -d ${ffdst} ]] || ffbad+="dir:${ffrel} "
	else
		cmp -s "${ffp}" "${ffdst}" || ffbad+="content:${ffrel} "
	fi
done < <(find ffref -mindepth 1)
[[ -z ${ffbad} ]]
tend $? "qmerge-test: [FWF] every package file matches installed (content+symlink)" \
	|| die "mismatches: ${ffbad}"

# reverse direction: every CONTENTS obj/sym came from the retained payload
ffcv="${ROOT}/var/db/pkg/sys-devel/qmerge-test-1.3/CONTENTS"
ffmiss=""
while read -r fft ffpath ffrest ; do
	case ${fft} in
	obj|sym) [[ -e "ffref/${ffpath#/}" || -L "ffref/${ffpath#/}" ]] \
		|| ffmiss+="${ffpath} " ;;
	esac
done < "${ffcv}"
[[ -z ${ffmiss} ]]
tend $? "qmerge-test: [FWF] every CONTENTS entry traces back to the payload" \
	|| die "not in payload: ${ffmiss}"

yes | qmerge -FU qmerge-test >/dev/null 2>&1
rm -rf ffref
rm -Rf "${ROOT}"/etc "${ROOT}"/usr

# check if INSTALL_MASK is applied well
export INSTALL_MASK="/etc"
out=$(yes | qmerge -F qmerge-test)
tend $? "qmerge-test: [M] install no /etc" || die "${out}"
# env-update generates ROOT/etc (env.d, profile.env, ...) like portage,
# so only the package's own config files must be absent
[[ ! -e ${ROOT}/etc/some.conf && ! -e ${ROOT}/etc/another.conf ]]
tend $? "qmerge-test: [M] found no /etc" || die "$(treedir "${ROOT}")"

[[ -x ${ROOT}/usr/bin/qmerge-test2 && -e ${ROOT}/usr/bin/dummy ]]
tend $? "qmerge-test: [M] unmasked files still installed" \
	|| die "$(treedir "${ROOT}")"

out=$(yes | qmerge -FU qmerge-test)
tend $? "qmerge-test: [U] uninstall" || die "${out}"
[[ ! -e ${ROOT}/etc/some.conf && ! -e ${ROOT}/etc/another.conf ]]
tend $? "qmerge-test: [U] /etc removed" || die "$(treedir "${ROOT}")"
[[ ! -e ${ROOT}/usr/bin/qmerge-test2 && ! -e ${ROOT}/usr/bin/dummy && \
   ! -d ${ROOT}/var/db/pkg/sys-devel ]]
tend $? "qmerge-test: [U] masked-install unmerge removed files and vdb" \
	|| die "$(treedir "${ROOT}")"

export INSTALL_MASK="/etc -/etc/some.conf"
out=$(yes | qmerge -F qmerge-test)
tend $? "qmerge-test: [M] install only /etc/some.conf" || die "${out}"
[[ ! -e ${ROOT}/etc/another.conf ]]
tend $? "qmerge-test: [M] found /etc/another.conf" || die "$(treedir "${ROOT}")"
[[ $(cat "${ROOT}/etc/some.conf" 2>/dev/null) == $'# file conf\nfoo' ]]
tend $? "qmerge-test: [M] negated entry kept /etc/some.conf" \
	|| die "$(treedir "${ROOT}")"

out=$(yes | qmerge -FU qmerge-test)
tend $? "qmerge-test: [U] uninstall" || die "${out}"
[[ ! -e ${ROOT}/etc/some.conf && ! -e ${ROOT}/etc/another.conf ]]
tend $? "qmerge-test: [U] /etc removed" || die "$(treedir "${ROOT}")"

export INSTALL_MASK="/usr -/usr/bin/dummy"
out=$(yes | qmerge -F qmerge-test)
tend $? "qmerge-test: [M] install only /usr/bin/dummy" || die "${out}"
[[ -e ${ROOT}/usr/bin/dummy ]]
tend $? "qmerge-test: [M] found /usr/bin/dummy" || die "$(treedir "${ROOT}")"
[[ ! -e ${ROOT}/usr/bin/qmerge-test ]]
tend $? "qmerge-test: [M] /usr/bin/qmerge-test absent" || die "$(treedir "${ROOT}")"

out=$(yes | qmerge -FU qmerge-test)
tend $? "qmerge-test: [U] uninstall" || die "${out}"
[[ ! -e ${ROOT}/usr/bin/dummy ]]
tend $? "qmerge-test: [U] /usr/bin/dummy removed" || die "$(treedir "${ROOT}")"

export INSTALL_MASK="/usr -/usr/bin /usr/bin/dummy"
out=$(yes | qmerge -F qmerge-test)
tend $? "qmerge-test: [M] install except /usr/bin/dummy" || die "${out}"
[[ ! -e ${ROOT}/usr/bin/dummy ]]
tend $? "qmerge-test: [M] found no /usr/bin/dummy" || die "$(treedir "${ROOT}")"
[[ -e ${ROOT}/usr/bin/qmerge-test2 ]]
tend $? "qmerge-test: [M] found /usr/bin/qmerge-test2" || die "$(treedir "${ROOT}")"

out=$(yes | qmerge -FU qmerge-test)
tend $? "qmerge-test: [U] uninstall" || die "${out}"
[[ ! -e ${ROOT}/usr/bin/qmerge-test2 ]]
tend $? "qmerge-test: [U] /usr/bin/qmerge-test2 removed" || die "$(treedir "${ROOT}")"

# Merging a package directory must merge into an existing dir, follow a
# symlink that resolves to a dir (keeping the symlink), and relocate a
# non-directory blocker aside to name.backup.NNNN, then create the dir
# Same as Portage does. Hopefully.
unset INSTALL_MASK
rm -rf "${ROOT}/usr" "${ROOT}/etc" "${ROOT}/realbin"

# [B-file] usr/bin is a regular FILE blocking the package's usr/bin/ dir
mkdir -p "${ROOT}/usr"
echo BLOCKER > "${ROOT}/usr/bin"
out=$(yes | qmerge -F qmerge-test-1.3)
tend $? "qmerge-test: [B-file] merge over a file blocker" || die "${out}"
[[ -d ${ROOT}/usr/bin && -x ${ROOT}/usr/bin/qmerge-test && \
   -f ${ROOT}/usr/bin.backup.0000 && \
   $(cat "${ROOT}/usr/bin.backup.0000") == BLOCKER ]]
tend $? "qmerge-test: [B-file] blocker renamed aside, dir merged" || die "$(treedir "${ROOT}")"
yes | qmerge -FU qmerge-test >/dev/null 2>&1
rm -rf "${ROOT}/usr" "${ROOT}/etc" "${ROOT}/realbin"

# [B-symdir] usr/bin is a symlink to a real dir: follow it, keep the symlink
mkdir -p "${ROOT}/usr" "${ROOT}/realbin"
ln -s ../realbin "${ROOT}/usr/bin"
out=$(yes | qmerge -F qmerge-test-1.3)
tend $? "qmerge-test: [B-symdir] merge over a symlink-to-dir" || die "${out}"
[[ -L ${ROOT}/usr/bin && -x ${ROOT}/realbin/qmerge-test && \
   ! -e ${ROOT}/usr/bin.backup.0000 ]]
tend $? "qmerge-test: [B-symdir] symlink kept, files followed into target" || die "$(treedir "${ROOT}")"
yes | qmerge -FU qmerge-test >/dev/null 2>&1
rm -rf "${ROOT}/usr" "${ROOT}/etc" "${ROOT}/realbin"

# [B-dir] usr/bin is a pre-existing real dir: merge into it, keep siblings
mkdir -p "${ROOT}/usr/bin"
echo keep > "${ROOT}/usr/bin/preexisting"
out=$(yes | qmerge -F qmerge-test-1.3)
tend $? "qmerge-test: [B-dir] merge into an existing dir" || die "${out}"
[[ -d ${ROOT}/usr/bin && -x ${ROOT}/usr/bin/qmerge-test && \
   -f ${ROOT}/usr/bin/preexisting && ! -e ${ROOT}/usr/bin.backup.0000 ]]
tend $? "qmerge-test: [B-dir] existing dir merged, sibling kept, no backup" || die "$(treedir "${ROOT}")"
yes | qmerge -FU qmerge-test >/dev/null 2>&1
rm -rf "${ROOT}/usr" "${ROOT}/etc" "${ROOT}/realbin"

# [B-escape] under a non-standard --root (this suite runs with ROOT != /),
# a destination dir-symlink whose target ESCAPES the root must be relocated
# (not followed through), so a package's files stay inside --root and never reach
# the host.
# (The in-root symlink follow is covered by [B-symdir] above)
rm -rf "${ROOT}/usr" "${ROOT}/etc" "${PWD}/escape-target"
mkdir -p "${ROOT}/usr" "${PWD}/escape-target"
ln -s "${PWD}/escape-target" "${ROOT}/usr/bin"
out=$(yes | qmerge -F qmerge-test-1.3 2>&1)
tend $? "qmerge-test: [B-escape] merge over an escaping --root symlink" || die "${out}"
[[ -d ${ROOT}/usr/bin && ! -L ${ROOT}/usr/bin && \
   -x ${ROOT}/usr/bin/qmerge-test && \
   ! -e ${PWD}/escape-target/qmerge-test ]]
tend $? "qmerge-test: [B-escape] escaping symlink relocated, files kept inside --root" \
	|| die "$(treedir "${ROOT}"); escape-target: $(ls -la "${PWD}/escape-target")"
[[ ${out} == *"escapes the root"* ]]
tend $? "qmerge-test: [B-escape] warned about the escaping symlink" || die "${out}"
yes | qmerge -FU qmerge-test >/dev/null 2>&1
rm -rf "${ROOT}/usr" "${ROOT}/etc" "${ROOT}/realbin" "${PWD}/escape-target"

# try all compressions we know to see if we handle them properly
pkgver=qmerge-test-1.3
rev=0
mkdir -p "${ROOT}"/pkgs/sys-devel
qtbz2 -s "${ROOT}${PKGDIR}"/sys-devel/${pkgver}.tbz2
export PKGDIR=/pkgs
bzip2 -dc < ${pkgver}.tar.bz2 > ${pkgver}.tar
xref=
for compr in "" brotli gzip bzip2 xz lz4 zstd lzip lzop ; do
	if [[ ${compr} != "" ]] ; then
		cexec=$(type -P ${compr} 2>/dev/null)
		echo "compressor: ${compr} = ${cexec}"
		if [[ ! -x ${cexec} ]] ; then
			echo "${WARN}SKIPPED:${NORMAL} qmerge-test: [X] ${compr} roundtrip (${compr} not installed)"
			continue
		fi
		f=${pkgver}.tar.${compr}
		${cexec} -c < ${pkgver}.tar > ${f}
	else
		echo "plain tar"
		f=${pkgver}.tar
	fi
	: $((rev++))
	qtbz2 -j ${f} ${pkgver}.xpak "${ROOT}"/pkgs/sys-devel/${pkgver}-r${rev}.tbz2
	ls -l "${ROOT}"/pkgs/sys-devel/${pkgver}-r${rev}.tbz2
	qlist -kIv | tee -a /dev/stderr | wc -l

	# see if we can install this package
	out=$(yes | qmerge -Fv =${pkgver}-r${rev})
	tend $? "qmerge-test: [X] install ${pkgver}-r${rev}" || die "${out}"
	qlist -Iv

	xsum=$(md5sum "${ROOT}/usr/bin/qmerge-test" 2>/dev/null | cut -d' ' -f1)
	[[ -z ${xref} ]] && xref=${xsum}
	[[ -x ${ROOT}/usr/bin/qmerge-test && ${xsum} == "${xref}" && \
	   $(cat "${ROOT}/etc/some.conf" 2>/dev/null) == $'# file conf\nfoo' ]]
	tend $? "qmerge-test: [X] ${compr:-tar} payload merged byte-identical" \
		|| die "sum=${xsum} ref=${xref}; $(treedir "${ROOT}")"

	out=$(yes | qmerge -FU qmerge-test)
	tend $? "qmerge-test: [X] uninstall ${pkgver}-r${rev}" || die "${out}"

	[[ ! -e ${ROOT}/usr/bin/qmerge-test && ! -e ${ROOT}/etc/another.conf ]]
	tend $? "qmerge-test: [X] ${compr:-tar} payload removed on unmerge" \
		|| die "$(treedir "${ROOT}")"

	rm "${ROOT}"/pkgs/sys-devel/${pkgver}-r${rev}.tbz2
done

if [[ -n ${GPKG_ENABLED} ]] ; then
	# create a gpkg and merge it
	qtbz2 -j ${f} ${pkgver}.xpak "${ROOT}"/pkgs/sys-devel/${pkgver}-r${rev}.tbz2
	out=$(yes | qmerge -Fv =${pkgver}-r${rev})
	tend $? "qmerge-test: [ ] install ${pkgver}-r${rev}" || die "${out}"
	qm_merged "sys-devel/${pkgver}" "[ ] install ${pkgver}-r${rev} really landed"
	out=$(qpkg -g ${pkgver}-r${rev})
	tend $? "qmerge-test: [ ] build gpkg.tar" || die "${out}"
	out=$(qpkg -p -c 2>&1)
	tend $? "qmerge-test: [ ] qpkg -p -c pretend clean over the vdb" || die "${out}"

	gbuilt=$(find "${ROOT}/pkgs/sys-devel" -name "${pkgver}-r${rev}*.gpkg.tar" \
		| head -1)
	gimg=$(tar tf "${gbuilt}" 2>/dev/null | grep 'image\.tar' | head -1)
	gimgn=0
	if [[ -n ${gimg} ]] && type -P zstd >/dev/null ; then
		gimgn=$(tar xOf "${gbuilt}" "${gimg}" 2>/dev/null | zstd -dc 2>/dev/null \
			| tar t 2>/dev/null | grep -c '^image/.*[^/]$')
	fi
	[[ -n ${gbuilt} && -n ${gimg} ]] && \
		tar tf "${gbuilt}" | grep -q 'metadata\.tar' && \
		[[ $(stat -c %s "${gbuilt}") -gt 1024 ]] && \
		{ ! type -P zstd >/dev/null || [[ ${gimgn} -ge 4 ]]; }
	tend $? "qmerge-test: [ ] built gpkg carries a real image and metadata" \
		|| die "file='${gbuilt}' imgfiles=${gimgn} $(tar tf "${gbuilt}" 2>/dev/null)"
	ls -l "${ROOT}"/pkgs/sys-devel/
	rm "${ROOT}"/pkgs/sys-devel/${pkgver}-r${rev}.tbz2
	ls -l "${ROOT}"/pkgs/sys-devel/
	qlist -kIv
	out=$(yes | qmerge -Fv =${pkgver}-r${rev})
	tend $? "qmerge-test: [G] install ${pkgver}-r${rev}" || die "${out}"

	[[ -x ${ROOT}/usr/bin/qmerge-test && \
	   $(md5sum "${ROOT}/usr/bin/qmerge-test" | cut -d' ' -f1) == "${xref}" && \
	   $(cat "${ROOT}/etc/some.conf" 2>/dev/null) == $'# file conf\nfoo' ]]
	tend $? "qmerge-test: [G] gpkg payload merged byte-identical" \
		|| die "$(treedir "${ROOT}")"

	out=$(yes | qmerge -FU qmerge-test)
	tend $? "qmerge-test: [G] uninstall ${pkgver}-r${rev}" || die "${out}"

	[[ ! -e ${ROOT}/usr/bin/qmerge-test ]]
	tend $? "qmerge-test: [G] gpkg payload removed on unmerge" \
		|| die "$(treedir "${ROOT}")"
fi

# [gpkg verify] structured-mutation for the GLEP-78 checks & tests
# (libq/gpkg.c: gpkg_member_ok + gpkg_manifest_verify).
# Build ONE valid gpkg, corrupt exactly one invariant per case, then assert qmerge refuses
# with the specific reason AND writes no VDB entry.
# (Nearly) Cloned from portage's test_gpkg_checksum, but exercised end-to-end through 
# the real merge path.
if [[ -n ${GPKG_ENABLED} ]] ; then
	gvpv=qmerge-test-1.3
	gvroot="${ROOT}/pkgs/sys-devel"

	# fresh valid gpkg: install the tbz2, rebuild it as a gpkg, drop the tbz2
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -rf "${gvroot}/qmerge-test"
	rm -f "${gvroot}/${gvpv}"*.tbz2 "${gvroot}/${gvpv}"*.gpkg.tar
	qtbz2 -j ${f} ${pkgver}.xpak "${gvroot}/${gvpv}.tbz2"
	yes | qmerge -Fv =${gvpv} >/dev/null 2>&1
	out=$(qpkg -g ${gvpv})
	tend $? "qmerge-test: [gpkg verify] build valid gpkg" || die "${out}"
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -f "${gvroot}/${gvpv}.tbz2"
	mapfile -t gvcand < <(find "${gvroot}" -type f \
		\( -name "${gvpv}.gpkg.tar" -o -name "${gvpv}-*.gpkg.tar" \) 2>/dev/null)
	[[ ${#gvcand[@]} -eq 1 ]]
	tend $? "qmerge-test: [gpkg verify] exactly one valid gpkg to mutate" || die "matched: ${gvcand[*]}"
	gvgpkg=${gvcand[0]}
	# derive the container's single prefix directory from the archive itself
	gvpfx=$(tar tf "${gvgpkg}" | head -1); gvpfx=${gvpfx%%/*}

	# explode once. 
	# every case rebuilds the outer ustar from a pristine copy
	# (in-place tar --delete/--append corrupts a libarchive-written ustar).
	gvex="${PWD}/gv-ex"
	rm -rf "${gvex}" "${gvex}.bak"
	mkdir -p "${gvex}"
	tar xf "${gvgpkg}" -C "${gvex}"
	cp -a "${gvex}" "${gvex}.bak"
	gvmem="${gvpfx}/gpkg-1 ${gvpfx}/metadata.tar.zst ${gvpfx}/image.tar.zst ${gvpfx}/Manifest"
	gv_gnutar=0
	tar --version 2>/dev/null | grep -qi 'GNU tar' && gv_gnutar=1

	gv_restore() { rm -rf "${gvex}"; cp -a "${gvex}.bak" "${gvex}"; }

	# the rebuilt-from-pieces gpkg must still merge
	gv_restore
	( cd "${gvex}" && tar --format=ustar -cf "${gvgpkg}" ${gvmem} )
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	out=$(yes | qmerge -Fv =${gvpv} 2>&1); rc=$?
	[[ ${rc} -eq 0 && -n $(qlist -Iv 2>/dev/null) ]]
	tend $? "qmerge-test: [gpkg verify] rebuilt-valid gpkg still merges" || die "${out}"
	yes | qmerge -FU qmerge-test >/dev/null 2>&1

	# a container whose metadata no longer reads is excluded at index
	# time by the populate reconcile
	gv_restore; printf 'notzstd' > "${gvex}/${gvpfx}/metadata.tar.zst"
	( cd "${gvex}" && tar --format=ustar -cf "${gvgpkg}" ${gvmem} )
	touch -d "@$(( $(stat -c %Y "${gvgpkg}") + 2 ))" "${gvgpkg}"
	out=$(yes | qmerge -Fv =${gvpv} 2>&1); rc=$?
	[[ ${rc} -ne 0 && ${out} == *"Invalid binary package"* && \
	   ${out} == *"cannot satisfy"* && -z $(qlist -Iv 2>/dev/null) ]]
	tend $? "qmerge-test: [gpkg verify] local corrupt gpkg excluded at index time" \
		|| die "rc=${rc}; ${out}"

	# the whole-file checksum against theindex entry quarantines the tamper 
	# (.checksum_failure move-aside)
	gv_restore
	( cd "${gvex}" && tar --format=ustar -cf "${gvgpkg}" ${gvmem} )
	qmaint binhost -f >/dev/null 2>&1
	cp -p "${gvgpkg}" "${PWD}/gv.ref"
	sed -i 's#DATA gpkg-1 17 #DATA gpkg-1 999 #' "${gvex}/${gvpfx}/Manifest"
	( cd "${gvex}" && tar --format=ustar -cf "${gvgpkg}" ${gvmem} )
	touch -r "${PWD}/gv.ref" "${gvgpkg}"
	out=$(yes | qmerge -Fv =${gvpv} 2>&1); rc=$?
	[[ ${rc} -ne 0 && ${out} == *"checksum mismatch"* && \
	   ${out} == *"moving aside"* && -e "${gvgpkg}.checksum_failure" && \
	   -z $(qlist -Iv 2>/dev/null) ]]
	tend $? "qmerge-test: [gpkg verify] forged-mtime tamper quarantined by checksum" \
		|| die "rc=${rc}; ${out}"
	rm -f "${gvgpkg}.checksum_failure" "${PWD}/gv.ref"

	# the manifest/member branches are only reachable through a binhost
	# that serves a self-inconsistent gpkg whose catalog hashes match the
	# served file
	gvstore="${ROOT}/gvstore"
	rm -rf "${gvstore}" cfggv
	mkdir -p "${gvstore}/sys-devel" cfggv/etc/portage/binrepos.conf
	printf '[gvrepo]\npriority = 1\nlocation = /gvstore\nsync-uri = http://127.0.0.1:1/\n' \
		> cfggv/etc/portage/binrepos.conf/gv.conf
	gvtgt="${gvstore}/sys-devel/${gvpv}.gpkg.tar"
	( cd "${gvex}.bak" && tar --format=ustar -cf "${gvtgt}" ${gvmem} )
	env PKGDIR=/gvstore qmaint binhost -f >/dev/null 2>&1
	rm -f "${gvgpkg}"
	qmaint binhost -f >/dev/null 2>&1

	# the malicious catalog shows the mutated file's own hashes
	gv_index() {
		sed -i -e "s#^MD5: .*#MD5: $(md5sum "${gvtgt}" | cut -d' ' -f1)#" \
			   -e "s#^SHA1: .*#SHA1: $(sha1sum "${gvtgt}" | cut -d' ' -f1)#" \
			   -e "s#^SIZE: .*#SIZE: $(stat -c %s "${gvtgt}")#" \
			   -e "s#^MTIME: .*#MTIME: $(stat -c %Y "${gvtgt}")#" \
			   "${gvstore}/Packages"
		rm -f "${gvstore}/Packages.gz"
	}
	gv_rebuild() { ( cd "${gvex}" && tar --format=ustar -cf "${gvtgt}" "$@" );
		gv_index; }
	# refusal assertion: nonzero rc, the specific reason, no VDB entry
	gv_reject() { # $1 label  $2 expected reason substring
		yes | qmerge -FU qmerge-test >/dev/null 2>&1
		local o rc v
		o=$(yes | env PORTAGE_CONFIGROOT="${PWD}/cfggv" \
			qmerge -Fv =${gvpv} 2>&1); rc=$?
		v=$(qlist -Iv 2>/dev/null)
		[[ ${rc} -ne 0 && ${o} == *"$2"* && ${o} == *"refusing to merge"* && -z ${v} ]]
		tend $? "qmerge-test: [gpkg verify] $1" || die "rc=${rc} vdb='${v}'; ${o}"
	}

	# a served-intact gpkg through the repo store must merge
	gv_restore; gv_rebuild ${gvmem}
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	out=$(yes | env PORTAGE_CONFIGROOT="${PWD}/cfggv" \
		qmerge -Fv =${gvpv} 2>&1); rc=$?
	[[ ${rc} -eq 0 && -n $(qlist -Iv 2>/dev/null) ]]
	tend $? "qmerge-test: [gpkg verify] repo-served valid gpkg merges" || die "${out}"
	yes | qmerge -FU qmerge-test >/dev/null 2>&1

	# gpkg_manifest_verify branches
	gv_restore; sed -i 's#DATA gpkg-1 17 #DATA gpkg-1 999 #' "${gvex}/${gvpfx}/Manifest"
	gv_rebuild ${gvmem}
	gv_reject "size mismatch refused" "size mismatch vs Manifest"

	gv_restore; sed -i 's#SHA512 5e67#SHA512 0e67#' "${gvex}/${gvpfx}/Manifest"
	gv_rebuild ${gvmem}
	gv_reject "SHA512 mismatch refused" "SHA512 mismatch vs Manifest"

	gv_restore; sed -i 's#BLAKE2B 36f7#BLAKE2B 06f7#' "${gvex}/${gvpfx}/Manifest"
	gv_rebuild ${gvmem}
	gv_reject "BLAKE2B mismatch refused" "BLAKE2B mismatch vs Manifest"

	gv_restore
	printf 'DATA ghost 5 SHA512 abc BLAKE2B def\n' >> "${gvex}/${gvpfx}/Manifest"
	gv_rebuild ${gvmem}
	gv_reject "listed-but-missing member refused" "missing from the package"

	gv_restore
	grep -v 'image.tar.zst' "${gvex}/${gvpfx}/Manifest" > "${gvex}/gvm" \
		&& mv "${gvex}/gvm" "${gvex}/${gvpfx}/Manifest"
	gv_rebuild ${gvmem}
	gv_reject "present-but-unlisted member refused" "present but not listed in the Manifest"

	gv_restore
	sed -i 's#^DATA gpkg-1 17 .*#DATA gpkg-1 17 MD5 d41d8cd98f00b204e9800998ecf8427e#' \
		"${gvex}/${gvpfx}/Manifest"
	gv_rebuild ${gvmem}
	gv_reject "unsupported-only checksum refused" "has no supported checksum"

	gv_restore
	grep -v ' gpkg-1 ' "${gvex}/${gvpfx}/Manifest" > "${gvex}/gvm" \
		&& mv "${gvex}/gvm" "${gvex}/${gvpfx}/Manifest"
	rm -f "${gvex}/${gvpfx}/gpkg-1"
	gv_rebuild "${gvpfx}/metadata.tar.zst" "${gvpfx}/image.tar.zst" "${gvpfx}/Manifest"
	gv_reject "missing gpkg-1 marker refused" "missing gpkg-1 version marker"

	gv_restore; rm -f "${gvex}/${gvpfx}/Manifest"
	gv_rebuild "${gvpfx}/gpkg-1" "${gvpfx}/metadata.tar.zst" "${gvpfx}/image.tar.zst"
	gv_reject "missing Manifest refused" "Manifest not found"

	gv_restore
	cat "${gvex}/${gvpfx}/Manifest" "${gvex}/${gvpfx}/Manifest" > "${gvex}/gvm" \
		&& mv "${gvex}/gvm" "${gvex}/${gvpfx}/Manifest"
	gv_rebuild ${gvmem}
	gv_reject "duplicate Manifest entry refused" "duplicate Manifest entry"

	# gpkg_member_ok branches
	gv_restore
	mkdir -p "${gvex}/${gvpfx}/sub"; echo x > "${gvex}/${gvpfx}/sub/f"
	gv_rebuild ${gvmem} "${gvpfx}/sub/f"
	gv_reject "two-level member refused" "not at exactly one directory level"

	gv_restore
	mkdir -p "${gvex}/gvother"; echo x > "${gvex}/gvother/f"
	gv_rebuild ${gvmem} "gvother/f"
	gv_reject "prefix-mismatch member refused" "do not share a single prefix directory"

	# same-name attack (duplicate member) needs GNU 'tar --transform' to store
	# two entries under one name
	if [[ ${gv_gnutar} -eq 1 ]] ; then
		gv_restore; cp "${gvex}/${gvpfx}/gpkg-1" "${gvex}/${gvpfx}/gpkg-1.dup"
		( cd "${gvex}" && tar --format=ustar -cf "${gvtgt}" ${gvmem} \
			--transform="s#${gvpfx}/gpkg-1.dup#${gvpfx}/gpkg-1#" "${gvpfx}/gpkg-1.dup" )
		gv_index
		gv_reject "duplicate member (same-name attack) refused" "duplicate member"

		# here's a absolute-path member (GNU tar -P keeps the leading slash)
		gv_restore; echo x > "${gvex}/gvabs"
		( cd "${gvex}" && tar --format=ustar -cf "${gvtgt}" ${gvmem} \
			-P --transform="s#^gvabs#/gvabs#" "gvabs" ) 2>/dev/null
		gv_index
		gv_reject "absolute-path member refused" "member with absolute path"
	else
		echo "${WARN}SKIPPED:${NORMAL} [gpkg verify] duplicate + absolute-path (need GNU tar)"
	fi

	# corrupting .gpkg metadata, image or manifest is already covered by the above,
	# in order to get a duplicate metadata member. 
	# we need to unpack the metadata.tar.zst, add a second metadata/PF, and repack it.
	if type -P zstd >/dev/null ; then
		gv_restore
		rm -rf "${gvex}/md"; mkdir "${gvex}/md"
		zstd -dc "${gvex}/${gvpfx}/metadata.tar.zst" | tar x -C "${gvex}/md"
		( cd "${gvex}/md" && tar --format=ustar -cf md.tar \
			metadata metadata/PF && \
		  zstd -q -f md.tar -o "../${gvpfx}/metadata.tar.zst" )
		sed -i "s#^DATA metadata.tar.zst .*#DATA metadata.tar.zst $(stat -c %s \
			"${gvex}/${gvpfx}/metadata.tar.zst") SHA512 $(sha512sum \
			"${gvex}/${gvpfx}/metadata.tar.zst" | cut -d" " -f1)#" \
			"${gvex}/${gvpfx}/Manifest"
		( cd "${gvex}" && tar --format=ustar -cf "${gvtgt}" ${gvmem} )
		gv_index
		gv_reject "duplicate metadata member refused" \
			"duplicate metadata member 'PF'"
	else
		echo "${WARN}SKIPPED:${NORMAL} [gpkg verify] duplicate metadata member (need zstd)"
	fi

	qtbz2 -j ${f} ${pkgver}.xpak "${gvroot}/${gvpv}.tbz2"
	qmaint binhost -f >/dev/null 2>&1
	yes | qmerge -Fv =${gvpv} >/dev/null 2>&1
	echo 7 > "${ROOT}/var/db/pkg/sys-devel/${gvpv}/BUILD_ID"
	rm -f "${gvroot}/${gvpv}"*.gpkg.tar "${gvroot}/qmerge-test/${gvpv}"*.gpkg.tar
	FEATURES="binpkg-multi-instance" qpkg -g ${gvpv} >/dev/null 2>&1
	gvbi=$(find "${gvroot}" -name "${gvpv}-*.gpkg.tar" | head -1)
	gvbn=${gvbi##*-}; gvbn=${gvbn%.gpkg.tar}
	gvbp=$(tar tf "${gvbi}" 2>/dev/null | head -1); gvbp=${gvbp%%/*}
	if type -P zstd >/dev/null ; then
		tar xOf "${gvbi}" "${gvbp}/metadata.tar.zst" > gvbi-md.zst 2>/dev/null
		[[ $(zstd -dc gvbi-md.zst | tar t | grep -c "^metadata/BUILD_ID$") -eq 1 && \
		   $(zstd -dc gvbi-md.zst | tar xO metadata/BUILD_ID) == "${gvbn}" ]]
		tend $? "qmerge-test: [qpkg] instance gpkg carries exactly one BUILD_ID, the computed one" \
			|| die "file=${gvbi} n=${gvbn} $(zstd -dc gvbi-md.zst | tar t | grep BUILD_ID)"
		rm -f gvbi-md.zst
	else
		echo "${WARN}SKIPPED:${NORMAL} [qpkg] gpkg BUILD_ID uniqueness (need zstd)"
	fi

	rm -f "${gvroot}/${gvpv}"*.xpak "${gvroot}/qmerge-test/${gvpv}"*.xpak
	FEATURES="binpkg-multi-instance" qpkg -x ${gvpv} >/dev/null 2>&1
	gvxi=$(find "${gvroot}" -name "${gvpv}-*.xpak" | head -1)
	gvxn=${gvxi##*-}; gvxn=${gvxn%.xpak}
	rm -f BUILD_ID
	qxpak -x "${gvxi}" BUILD_ID >/dev/null 2>&1
	[[ $(qxpak -l "${gvxi}" 2>/dev/null | grep -c "^BUILD_ID$") -eq 1 && \
	   $(cat BUILD_ID 2>/dev/null) == "${gvxn}" ]]
	tend $? "qmerge-test: [qpkg] instance xpak records the computed BUILD_ID, not the stale VDB one" \
		|| die "file=${gvxi} n=${gvxn} got=$(cat BUILD_ID 2>/dev/null)"
	rm -f BUILD_ID

	for gvc in xz none ; do
		rm -f "${gvroot}/${gvpv}"*.gpkg.tar "${gvroot}/qmerge-test/${gvpv}"*.gpkg.tar
		out=$(BINPKG_COMPRESS=${gvc} qpkg -g ${gvpv} 2>&1); rc=$?
		gvcf=$(find "${gvroot}" -name "${gvpv}*.gpkg.tar" | head -1)
		gvext=""; [[ ${gvc} == xz ]] && gvext=".xz"
		[[ ${rc} -eq 0 && -n ${gvcf} ]] && \
			tar tf "${gvcf}" | grep -q "image.tar${gvext}\$" && \
			tar tf "${gvcf}" | grep -q "metadata.tar${gvext}\$" && \
			! tar tf "${gvcf}" | grep -q "tar.zst"
		tend $? "qmerge-test: [qpkg] BINPKG_COMPRESS=${gvc} selects that codec" \
			|| die "rc=${rc} ${out} $(tar tf "${gvcf}" 2>/dev/null)"
		if [[ ${gvc} == none ]] ; then
			[[ ${out} == *"readable by qmerge only"* ]]
			tend $? "qmerge-test: [qpkg] uncompressed gpkg warns it is unreadable by portage" \
				|| die "${out}"
		else
			[[ ${out} != *"readable by qmerge only"* ]]
			tend $? "qmerge-test: [qpkg] compressed gpkg carries no such warning" \
				|| die "${out}"
		fi
		touch -d "@$(( $(stat -c %Y "${gvcf}") + 2 ))" "${gvcf}"
		q --root "${ROOT}" qmaint binhost -f >/dev/null 2>&1
		yes | qmerge -FU qmerge-test >/dev/null 2>&1
		out=$(yes | qmerge -Fv =${gvpv} 2>&1); rc=$?
		[[ ${rc} -eq 0 && -n $(qlist -Iv 2>/dev/null) ]]
		tend $? "qmerge-test: [qpkg] BINPKG_COMPRESS=${gvc} gpkg merges back" \
			|| die "rc=${rc} ${out}"
	done

	rm -f "${gvroot}/${gvpv}"*.gpkg.tar "${gvroot}/qmerge-test/${gvpv}"*.gpkg.tar
	out=$(BINPKG_COMPRESS=bogus qpkg -g ${gvpv} 2>&1); rc=$?
	[[ ${rc} -ne 0 && ${out} == *"unsupported BINPKG_COMPRESS: bogus"* && \
	   -z $(find "${gvroot}" -name "${gvpv}*.gpkg.tar" 2>/dev/null) ]]
	tend $? "qmerge-test: [qpkg] unknown BINPKG_COMPRESS refused, nothing written" \
		|| die "rc=${rc} $(find "${gvroot}" -type f 2>&1) ${out}"

	out=$(BINPKG_COMPRESS=zstd BINPKG_COMPRESS_FLAGS="-19" \
		qpkg -g ${gvpv} 2>&1); rc=$?
	[[ ${rc} -eq 0 && ${out} != *"ignored"* ]]
	tend $? "qmerge-test: [qpkg] numeric BINPKG_COMPRESS_FLAGS level accepted" \
		|| die "rc=${rc} ${out}"

	rm -f "${gvroot}/${gvpv}"*.gpkg.tar "${gvroot}/qmerge-test/${gvpv}"*.gpkg.tar
	out=$(BINPKG_COMPRESS=zstd BINPKG_COMPRESS_FLAGS="--rsyncable" \
		qpkg -g ${gvpv} 2>&1); rc=$?
	[[ ${rc} -eq 0 && ${out} == *"'--rsyncable' not supported"* && \
	   -n $(find "${gvroot}" -name "${gvpv}*.gpkg.tar" | head -1) ]]
	tend $? "qmerge-test: [qpkg] unknown compress flag warns but builds" \
		|| die "rc=${rc} ${out}"

	rm -f "${gvroot}/${gvpv}"*.gpkg.tar "${gvroot}/qmerge-test/${gvpv}"*.gpkg.tar
	out=$(BINPKG_COMPRESS=zstd BINPKG_COMPRESS_FLAGS="--generic-bogus" \
		BINPKG_COMPRESS_FLAGS_ZSTD="-19" qpkg -g ${gvpv} 2>&1); rc=$?
	[[ ${rc} -eq 0 && ${out} != *"ignored"* ]]
	tend $? "qmerge-test: [qpkg] per-codec FLAGS override replaces the generic" \
		|| die "rc=${rc} ${out}"

	if [[ $(id -u) -ne 0 ]] ; then
		mkdir -p "${ROOT}/rox"; chmod 0555 "${ROOT}/rox"
		out=$(PKGDIR=/rox qpkg -x ${gvpv} 2>&1); rc=$?
		[[ ${rc} -ne 0 && ${out} == *"No write access to"* ]]
		tend $? "qmerge-test: [qpkg] unwritable PKGDIR refused with portage's message" \
			|| die "rc=${rc} ${out}"
		chmod 0755 "${ROOT}/rox"
	else
		echo "${WARN}SKIPPED:${NORMAL} [qpkg] unwritable-PKGDIR refusal (root bypasses W_OK)"
	fi

	mkdir -p "${ROOT}/keepmode"; chmod 2775 "${ROOT}/keepmode"
	out=$(PKGDIR=/keepmode qpkg -x ${gvpv} 2>&1); rc=$?
	[[ ${rc} -eq 0 && $(stat -c %a "${ROOT}/keepmode") == "2775" ]]
	tend $? "qmerge-test: [qpkg] existing PKGDIR mode left untouched" \
		|| die "rc=${rc} now=$(stat -c %a "${ROOT}/keepmode") ${out}"

	rm -rf "${ROOT}/freshpd"
	out=$(PKGDIR=/freshpd qpkg -x ${gvpv} 2>&1); rc=$?
	[[ ${rc} -eq 0 && $(stat -c %a "${ROOT}/freshpd") == "750" ]]
	tend $? "qmerge-test: [qpkg] created PKGDIR gets 0750" \
		|| die "rc=${rc} mode=$(stat -c %a "${ROOT}/freshpd" 2>/dev/null) ${out}"
	rm -rf "${ROOT}/rox" "${ROOT}/keepmode" "${ROOT}/freshpd"

	# clean up tests' artifacts and leave no gpkg behind for later blocks
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -rf "${gvex}" "${gvex}.bak" "${gvroot}/qmerge-test" "${gvstore}" cfggv
	rm -f "${gvroot}/${gvpv}.tbz2"
	qmaint binhost -f >/dev/null 2>&1
fi

# root drops signature verification to a child running as 'nobody',
# which cannot read a 0700 test keyring. Check the condition FIRST and
# tell the user what to change; no silent chmod.
qmerge_keyring_setup() { # $1 home  $2 family label; 0 = usable
	rm -rf "$1"; mkdir -m 700 "$1"
	# same gpg.conf a qetuto-managed home carries: a privilege-dropped
	# verify child on a read-only home dies in the trustdb auto-check
	printf 'no-greeting\nno-auto-check-trustdb\n' > "$1/gpg.conf"
	[[ $(id -u) -ne 0 ]] && return 0
	if [[ -n ${QMERGE_TEST_KEYRING_PUBLIC} ]] ; then
		chmod a+rx "$1"
		return 0
	fi
	echo "${WARN}SKIPPED:${NORMAL} $2: running as root; signature verification drops to 'nobody', which cannot read the 0700 test keyring $1"
	echo "         to run these checks as root, opt in with: export QMERGE_TEST_KEYRING_PUBLIC=1"
	echo "         (the suite then creates its throwaway keyrings world-readable, chmod -R a+rX)"
	return 1
}
qmerge_keyring_ready() { # $1... home dirs, after keys were written
	local kh
	# gpg.conf suppresses verify-time trustdb auto-checks, so validity
	# must be computed explicitly while the home is still writable
	# (qetuto does the same for the homes it manages)
	for kh in "$@" ; do
		GNUPGHOME="${kh}" gpg --batch --check-trustdb >/dev/null 2>&1
	done
	[[ $(id -u) -eq 0 && -n ${QMERGE_TEST_KEYRING_PUBLIC} ]] || return 0
	chmod -R a+rX "$@" 2>/dev/null
}

# sign a valid gpkg with a throwaway keyring, then assert accept/refuse per GLEP 78/79.
# BINPKG_GPG_VERIFY_GPG_HOME points verification at the test keyring.
if [[ -n ${GPKG_ENABLED} && -n ${GPGME_ENABLED} ]] && type -P gpg >/dev/null ; then
	gspv=qmerge-test-1.3
	gsroot="${ROOT}/pkgs/sys-devel"

	# fresh valid gpkg up for the takes
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -rf "${gsroot}/qmerge-test"
	rm -f "${gsroot}/${gspv}"*.tbz2 "${gsroot}/${gspv}"*.gpkg.tar
	qtbz2 -j ${f} ${pkgver}.xpak "${gsroot}/${gspv}.tbz2"
	yes | qmerge -Fv =${gspv} >/dev/null 2>&1
	qpkg -g ${gspv} >/dev/null 2>&1
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -f "${gsroot}/${gspv}.tbz2"
	mapfile -t gscand < <(find "${gsroot}" -type f \
		\( -name "${gspv}.gpkg.tar" -o -name "${gspv}-*.gpkg.tar" \) 2>/dev/null)
	gsgpkg=${gscand[0]}
	gspfx=$(tar tf "${gsgpkg}" | head -1); gspfx=${gspfx%%/*}

	gshome="${PWD}/gs-gnupg"
	if qmerge_keyring_setup "${gshome}" "[gpkg signing]" && \
			GNUPGHOME="${gshome}" gpg --batch --quick-gen-key --pinentry-mode loopback \
			--passphrase '' 'qmerge-test <qmerge@test.invalid>' ed25519 sign 0 \
			>/dev/null 2>&1 ; then
		gsfeat='config-protect-if-modified binpkg-request-signature'
		gsex="${PWD}/gs-ex"
		rm -rf "${gsex}" "${gsex}.signed"
		mkdir -p "${gsex}"
		cp "${gsgpkg}" "${PWD}/gs-unsigned.gpkg.tar"
		tar xf "${gsgpkg}" -C "${gsex}"

		# sign: detached .sig per member (Manifest-listed, SHA512 suffices)
		( cd "${gsex}/${gspfx}" && \
		  for gsm in gpkg-1 metadata.tar.zst image.tar.zst ; do
			GNUPGHOME="${gshome}" gpg --batch --yes --pinentry-mode loopback \
				--passphrase '' --detach-sign --armor -o "${gsm}.sig" "${gsm}" \
				|| exit 1
			printf 'DATA %s %s SHA512 %s\n' "${gsm}.sig" \
				"$(stat -c %s "${gsm}.sig")" \
				"$(sha512sum "${gsm}.sig" | cut -d' ' -f1)" >> Manifest
		  done && \
		  GNUPGHOME="${gshome}" gpg --batch --yes --pinentry-mode loopback \
			--passphrase '' --clearsign -o Manifest.signed Manifest && \
		  mv Manifest.signed Manifest )
		tend $? "qmerge-test: [gpkg signing] sign gpkg with test keyring" || die "signing failed"
		qmerge_keyring_ready "${gshome}"
		cp -a "${gsex}" "${gsex}.signed"
		gsmem="${gspfx}/gpkg-1 ${gspfx}/gpkg-1.sig \
			${gspfx}/metadata.tar.zst ${gspfx}/metadata.tar.zst.sig \
			${gspfx}/image.tar.zst ${gspfx}/image.tar.zst.sig ${gspfx}/Manifest"

		gs_epoch=$(date +%s); gs_tick=0
		gs_bump() { gs_tick=$((gs_tick+2));
			touch -d "@$((gs_epoch+gs_tick))" "${gsgpkg}"; }
		gs_rebuild() { ( cd "${gsex}" && tar --format=ustar -cf "${gsgpkg}" ${gsmem} );
			gs_bump; }
		gs_restore() { rm -rf "${gsex}"; cp -a "${gsex}.signed" "${gsex}"; }
		# $1 label  $2 expected substring  $3 keyring home
		gs_reject() {
			yes | qmerge -FU qmerge-test >/dev/null 2>&1
			local o rc v
			o=$(yes | env FEATURES="${gsfeat}" BINPKG_GPG_VERIFY_GPG_HOME="$3" \
				qmerge -Fv =${gspv} 2>&1); rc=$?
			v=$(qlist -Iv 2>/dev/null)
			[[ ${rc} -ne 0 && ${o} == *"$2"* && ${o} == *"refusing to merge"* && -z ${v} ]]
			tend $? "qmerge-test: [gpkg signing] $1" || die "rc=${rc} vdb='${v}'; ${o}"
		}

		# properly signed gpkg accepted under request-signature
		gs_restore; gs_rebuild
		yes | qmerge -FU qmerge-test >/dev/null 2>&1
		out=$(yes | env FEATURES="${gsfeat}" BINPKG_GPG_VERIFY_GPG_HOME="${gshome}" \
			qmerge -Fv =${gspv} 2>&1); rc=$?
		[[ ${rc} -eq 0 && -n $(qlist -Iv 2>/dev/null) ]]
		tend $? "qmerge-test: [gpkg signing] signed gpkg accepted (request-signature)" || die "${out}"
		yes | qmerge -FU qmerge-test >/dev/null 2>&1

		# evil tamper a member + patch its DATA line INSIDE the clearsigned
		# Manifest: integrity passes, the Manifest signature must not
		gs_restore
		printf 'X' | dd of="${gsex}/${gspfx}/image.tar.zst" bs=1 seek=100 \
			conv=notrunc 2>/dev/null
		sed -i "s#^DATA image.tar.zst .*#DATA image.tar.zst $(stat -c %s \
			"${gsex}/${gspfx}/image.tar.zst") SHA512 $(sha512sum \
			"${gsex}/${gspfx}/image.tar.zst" | cut -d' ' -f1)#" \
			"${gsex}/${gspfx}/Manifest"
		gs_rebuild
		gs_reject "tampered signed gpkg refused" \
			"failed OpenPGP signature verification" "${gshome}"

		# signature from a key the trust keyring does not hold
		gs_restore; gs_rebuild
		mkdir -m 700 -p "${PWD}/gs-gnupg-empty"
		qmerge_keyring_ready "${PWD}/gs-gnupg-empty"
		gs_reject "signature from untrusted key refused" \
			"Manifest signature missing, invalid, or from an untrusted key" \
			"${PWD}/gs-gnupg-empty"

		# unsigned package while signatures are mandatory
		yes | qmerge -FU qmerge-test >/dev/null 2>&1
		cp "${PWD}/gs-unsigned.gpkg.tar" "${gsgpkg}"
		gs_bump
		gs_reject "unsigned gpkg refused (request-signature)" \
			"carries no OpenPGP signature" "${gshome}"

		# binpkg-ignore-signature takes precedence over request
		yes | qmerge -FU qmerge-test >/dev/null 2>&1
		out=$(yes | env FEATURES="${gsfeat} binpkg-ignore-signature" \
			BINPKG_GPG_VERIFY_GPG_HOME="${PWD}/gs-gnupg-empty" \
			qmerge -Fv =${gspv} 2>&1); rc=$?
		[[ ${rc} -eq 0 && -n $(qlist -Iv 2>/dev/null) ]]
		tend $? "qmerge-test: [gpkg signing] ignore-signature overrides request" || die "${out}"

		gpgconf --homedir "${gshome}" --kill all >/dev/null 2>&1
		yes | qmerge -FU qmerge-test >/dev/null 2>&1
		rm -rf "${gsex}" "${gsex}.signed" "${gshome}" "${PWD}/gs-gnupg-empty"
		rm -f "${PWD}/gs-unsigned.gpkg.tar"
		rm -rf "${gsroot}/qmerge-test"
	else
		echo "${WARN}SKIPPED:${NORMAL} [gpkg signing] gpg cannot generate a test key"
		rm -rf "${gshome}" "${gsroot}/qmerge-test"
	fi
else
	echo "${WARN}SKIPPED:${NORMAL} [gpkg signing] checks (need gpkg + gpgme builds and gpg installed)"
fi

# qgpkg-sign = portage gpkg-sign clone. 
# sign/re-sign an existing gpkg in place, pkgbuilder side
if [[ -n ${GPKG_ENABLED} ]] && type -P gpg >/dev/null ; then
	ggpv=qmerge-test-1.3
	ggroot="${ROOT}/pkgs/sys-devel"
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -rf "${ggroot}/qmerge-test"
	rm -f "${ggroot}/${ggpv}"*.tbz2 "${ggroot}/${ggpv}"*.gpkg.tar
	qtbz2 -j ${f} ${pkgver}.xpak "${ggroot}/${ggpv}.tbz2"
	yes | qmerge -Fv =${ggpv} >/dev/null 2>&1
	qpkg -g ${ggpv} >/dev/null 2>&1
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -f "${ggroot}/${ggpv}.tbz2"
	mapfile -t ggcand < <(find "${ggroot}" -type f \
		\( -name "${ggpv}.gpkg.tar" -o -name "${ggpv}-*.gpkg.tar" \) 2>/dev/null)
	gggpkg=${ggcand[0]}
	ggpfx=$(tar tf "${gggpkg}" | head -1); ggpfx=${ggpfx%%/*}

	gghome="${PWD}/gg-gnupg"
	if qmerge_keyring_setup "${gghome}" "gpkg-sign" && \
			GNUPGHOME="${gghome}" gpg --batch --quick-gen-key --pinentry-mode loopback \
			--passphrase '' 'local' ed25519 sign 0 >/dev/null 2>&1 ; then
		ggkey=$(GNUPGHOME="${gghome}" gpg --batch --list-keys --with-colons \
			| awk -F: '/^fpr/{print $10; exit}')
		qmerge_keyring_ready "${gghome}"
		ggenv() {
			env BINPKG_GPG_SIGNING_GPG_HOME="${gghome}" \
				BINPKG_GPG_SIGNING_KEY="${ggkey}" \
				BINPKG_GPG_SIGNING_BASE_COMMAND='gpg --sign --armor [PORTAGE_CONFIG]' \
				"$@"
		}
		cp "${gggpkg}" "${PWD}/gg-unsigned.gpkg.tar"

		out=$(qgpkg-sign "${gggpkg}" 2>&1); rc=$?
		[[ ${rc} -ne 0 && ${out} == *"BINPKG_GPG_SIGNING_GPG_HOME is not set"* ]]
		tend $? "qmerge-test: gpkg-sign: missing GPG_HOME refused with portage text" \
			|| die "rc=${rc}; ${out}"

		out=$(env BINPKG_GPG_SIGNING_GPG_HOME="${gghome}" \
			qgpkg-sign "${gggpkg}" 2>&1); rc=$?
		[[ ${rc} -ne 0 && ${out} == *"BINPKG_GPG_SIGNING_KEY is not set"* ]]
		tend $? "qmerge-test: gpkg-sign: missing KEY refused with portage text" \
			|| die "rc=${rc}; ${out}"

		out=$(ggenv qgpkg-sign "${PWD}/gg-does-not-exist.gpkg.tar" 2>&1); rc=$?
		[[ ${rc} -ne 0 && ${out} == *"File not found:"* ]]
		tend $? "qmerge-test: gpkg-sign: missing file refused" \
			|| die "rc=${rc}; ${out}"

		head -c 4096 /dev/urandom > "${PWD}/gg-bad.gpkg.tar"
		out=$(ggenv qgpkg-sign "${PWD}/gg-bad.gpkg.tar" 2>&1); rc=$?
		[[ ${rc} -ne 0 && ${out} == *"Invalid binary package format:"* ]]
		tend $? "qmerge-test: gpkg-sign: garbage file refused" \
			|| die "rc=${rc}; ${out}"
		rm -f "${PWD}/gg-bad.gpkg.tar"

		out=$(ggenv qgpkg-sign "${gggpkg}" 2>&1); rc=$?
		[[ ${rc} -eq 0 && ${out} == *"${gggpkg} signed."* ]] && \
			tar tf "${gggpkg}" | grep -q "image.tar.*\.sig" && \
			tar xOf "${gggpkg}" "${ggpfx}/Manifest" \
				| grep -q -- "-----BEGIN PGP SIGNED MESSAGE-----"
		tend $? "qmerge-test: gpkg-sign: unsigned gpkg signed (sigs + clearsigned Manifest)" \
			|| die "rc=${rc}; ${out}"

		out=$(ggenv qgpkg-sign --skip-signed "${gggpkg}" 2>&1); rc=$?
		[[ ${rc} -eq 0 && ${out} == *"already signed, skipping."* ]]
		tend $? "qmerge-test: gpkg-sign: --skip-signed short-circuits" \
			|| die "rc=${rc}; ${out}"

		if [[ -n ${GPGME_ENABLED} ]] ; then
			out=$(ggenv env BINPKG_GPG_VERIFY_GPG_HOME="${gghome}" \
				qgpkg-sign "${gggpkg}" 2>&1); rc=$?
			[[ ${rc} -eq 0 && ${out} == *"${gggpkg} signed."* ]]
			tend $? "qmerge-test: gpkg-sign: signed gpkg verifies and re-signs" \
				|| die "rc=${rc}; ${out}"

			ggsig1=$(tar xOf "${gggpkg}" "${ggpfx}/image.tar.zst.sig" 2>/dev/null \
				| sha512sum | cut -d' ' -f1)
			out=$(ggenv env BINPKG_GPG_VERIFY_GPG_HOME="${gghome}" \
				qgpkg-sign --keep-current-signature "${gggpkg}" 2>&1); rc=$?
			ggsig2=$(tar xOf "${gggpkg}" "${ggpfx}/image.tar.zst.sig" 2>/dev/null \
				| sha512sum | cut -d' ' -f1)
			[[ ${rc} -eq 0 && -n ${ggsig1} && ${ggsig1} == "${ggsig2}" ]]
			tend $? "qmerge-test: gpkg-sign: --keep-current-signature preserves sig bytes" \
				|| die "rc=${rc} sig1=${ggsig1} sig2=${ggsig2}; ${out}"
		fi

		ggex="${PWD}/gg-ex"
		rm -rf "${ggex}"; mkdir -p "${ggex}"
		tar xf "${gggpkg}" -C "${ggex}"
		printf 'X' | dd of="${ggex}/${ggpfx}/image.tar.zst" bs=1 seek=100 \
			conv=notrunc 2>/dev/null
		( cd "${ggex}" && tar --format=ustar -cf "${PWD}/../gg-tampered.gpkg.tar" \
			$(find "${ggpfx}" -type f | sort) )
		cp "${PWD}/gg-tampered.gpkg.tar" "${PWD}/gg-tampered.orig"
		out=$(ggenv env BINPKG_GPG_VERIFY_GPG_HOME="${gghome}" \
			qgpkg-sign "${PWD}/gg-tampered.gpkg.tar" 2>&1); rc=$?
		[[ ${rc} -ne 0 && ${out} == *"Signature exception:"* ]] && \
			cmp -s "${PWD}/gg-tampered.gpkg.tar" "${PWD}/gg-tampered.orig"
		tend $? "qmerge-test: gpkg-sign: tampered member refused, file untouched" \
			|| die "rc=${rc}; ${out}"

		( cd "${ggex}" && tar --format=ustar -cf "${PWD}/../gg-direntry.gpkg.tar" \
			"${ggpfx}" )
		cp "${PWD}/gg-direntry.gpkg.tar" "${PWD}/gg-direntry.orig"
		out=$(ggenv qgpkg-sign "${PWD}/gg-direntry.gpkg.tar" 2>&1); rc=$?
		[[ ${rc} -ne 0 && ${out} == *"non-regular member"* && \
			${out} == *"Invalid binary package format:"* ]] && \
			cmp -s "${PWD}/gg-direntry.gpkg.tar" "${PWD}/gg-direntry.orig"
		tend $? "qmerge-test: gpkg-sign: directory entry refused at format layer" \
			|| die "rc=${rc}; ${out}"
		rm -f "${PWD}/gg-direntry.gpkg.tar" "${PWD}/gg-direntry.orig"
		rm -rf "${ggex}" "${PWD}/gg-tampered.gpkg.tar" "${PWD}/gg-tampered.orig"

		out=$(FEATURES='config-protect-if-modified binpkg-request-signature' \
			ggenv qgpkg-sign "${PWD}/gg-unsigned.gpkg.tar" 2>&1); rc=$?
		[[ ${rc} -ne 0 && ${out} == *"Signature exception:"* ]]
		tend $? "qmerge-test: gpkg-sign: unsigned refused under request-signature" \
			|| die "rc=${rc}; ${out}"

		out=$(FEATURES='config-protect-if-modified binpkg-request-signature' \
			ggenv qgpkg-sign --allow-unsigned "${PWD}/gg-unsigned.gpkg.tar" 2>&1); rc=$?
		[[ ${rc} -eq 0 && \
		   ${out} == *"gg-unsigned.gpkg.tar signed."* ]] && \
			tar tf "${PWD}/gg-unsigned.gpkg.tar" | grep -q 'image\.tar.*\.sig'
		tend $? "qmerge-test: gpkg-sign: --allow-unsigned signs under request-signature" \
			|| die "rc=${rc}; ${out}"

		if [[ -n ${GPGME_ENABLED} ]] ; then
			qmaint binhost -f >/dev/null 2>&1
			yes | qmerge -FU qmerge-test >/dev/null 2>&1
			out=$(yes | env \
				FEATURES='config-protect-if-modified binpkg-request-signature' \
				BINPKG_GPG_VERIFY_GPG_HOME="${gghome}" \
				qmerge -Fv =${ggpv} 2>&1); rc=$?
			[[ ${rc} -eq 0 && -n $(qlist -Iv 2>/dev/null) ]]
			tend $? "qmerge-test: gpkg-sign: qgpkg-sign output merges under request-signature" \
				|| die "rc=${rc}; ${out}"
			yes | qmerge -FU qmerge-test >/dev/null 2>&1
		fi

		# build-time signing: FEATURES=binpkg-signing in qpkg -g
		rm -rf "${ggroot}/qmerge-test"
		rm -f "${ggroot}/${ggpv}"*.tbz2 "${ggroot}/${ggpv}"*.gpkg.tar
		qtbz2 -j ${f} ${pkgver}.xpak "${ggroot}/${ggpv}.tbz2"
		qmaint binhost -f >/dev/null 2>&1
		yes | qmerge -Fv =${ggpv} >/dev/null 2>&1

		out=$(FEATURES='config-protect-if-modified binpkg-signing' \
			qpkg -g ${ggpv} 2>&1); rc=$?
		ggcomp=$(find "${ggroot}" -name "${ggpv}*.gpkg.tar" | head -1)
		[[ ${out} == *"BINPKG_GPG_SIGNING_GPG_HOME is not set"* && \
		   -z ${ggcomp} ]]
		tend $? "qmerge-test: gpkg-sign: build-time signing refused without vars" \
			|| die "rc=${rc} comp='${ggcomp}'; ${out}"

		out=$(FEATURES='config-protect-if-modified binpkg-signing' \
			ggenv qpkg -g ${ggpv} 2>&1); rc=$?
		ggcomp=$(find "${ggroot}" -name "${ggpv}*.gpkg.tar" | head -1)
		ggpfx2=$(tar tf "${ggcomp}" 2>/dev/null | head -1); ggpfx2=${ggpfx2%%/*}
		[[ ${rc} -eq 0 && -n ${ggcomp} ]] && \
			tar tf "${ggcomp}" | grep -q "image.tar.*\.sig" && \
			tar tf "${ggcomp}" | grep -q "metadata.tar.*\.sig" && \
			tar xOf "${ggcomp}" "${ggpfx2}/Manifest" \
				| grep -q -- "-----BEGIN PGP SIGNED MESSAGE-----"
		tend $? "qmerge-test: gpkg-sign: build-time signing emits signed gpkg" \
			|| die "rc=${rc} comp='${ggcomp}'; ${out}"

		if [[ -n ${GPGME_ENABLED} ]] ; then
			rm -f "${ggroot}/${ggpv}.tbz2"
			qmaint binhost -f >/dev/null 2>&1
			yes | qmerge -FU qmerge-test >/dev/null 2>&1
			out=$(yes | env \
				FEATURES='config-protect-if-modified binpkg-request-signature' \
				BINPKG_GPG_VERIFY_GPG_HOME="${gghome}" \
				qmerge -Fv =${ggpv} 2>&1); rc=$?
			[[ ${rc} -eq 0 && -n $(qlist -Iv 2>/dev/null) ]]
			tend $? "qmerge-test: gpkg-sign: build-time signed gpkg merges under request-signature" \
				|| die "rc=${rc}; ${out}"
		else
			yes | qmerge -FU qmerge-test >/dev/null 2>&1
			yes | qmerge -Fv =${ggpv} >/dev/null 2>&1
		fi

		# the backup path shares the composer: snapshots come out signed
		rm -f "${ggroot}"/${ggpv}*.gpkg.tar
		qmaint binhost -f >/dev/null 2>&1
		out=$(yes | FEATURES='config-protect-if-modified unmerge-backup binpkg-signing' \
			ggenv qmerge -FU qmerge-test 2>&1)
		ggcomp=$(find "${ggroot}" -name "${ggpv}*.gpkg.tar" | head -1)
		[[ -n ${ggcomp} ]] && tar tf "${ggcomp}" | grep -q "image.tar.*\.sig"
		tend $? "qmerge-test: gpkg-sign: unmerge-backup snapshot is signed under binpkg-signing" \
			|| die "comp='${ggcomp}'; ${out}"

		gpgconf --homedir "${gghome}" --kill all >/dev/null 2>&1
		rm -rf "${gghome}" "${ggroot}/qmerge-test"
		rm -f "${PWD}/gg-unsigned.gpkg.tar" "${ggroot}"/${ggpv}*.gpkg.tar \
			"${ggroot}/${ggpv}.tbz2"
		qmaint binhost -f >/dev/null 2>&1
	else
		echo "${WARN}SKIPPED:${NORMAL} gpkg-sign: gpg cannot generate a test key"
		rm -rf "${gghome}" "${ggroot}/qmerge-test"
	fi
else
	echo "${WARN}SKIPPED:${NORMAL} gpkg-sign: checks (need a gpkg build and gpg installed)"
fi

# verify-signature: per-repo binrepos.conf policy vs the FEATURES
# overrides, the portage test_gpkg_require_signed_repo matrix
if [[ -n ${GPKG_ENABLED} && -n ${GPGME_ENABLED} ]] && type -P gpg >/dev/null ; then
	vspv=qmerge-test-1.3
	vsroot="${ROOT}/pkgs/sys-devel"
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -rf "${vsroot}/qmerge-test"
	rm -f "${vsroot}/${vspv}"*.tbz2 "${vsroot}/${vspv}"*.gpkg.tar
	qtbz2 -j ${f} ${pkgver}.xpak "${vsroot}/${vspv}.tbz2"
	yes | qmerge -Fv =${vspv} >/dev/null 2>&1
	qpkg -g ${vspv} >/dev/null 2>&1
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -f "${vsroot}/${vspv}.tbz2"
	mapfile -t vscand < <(find "${vsroot}" -type f \
		\( -name "${vspv}.gpkg.tar" -o -name "${vspv}-*.gpkg.tar" \) 2>/dev/null)
	vsgpkg=${vscand[0]}

	vshome="${PWD}/vs-gnupg"
	if qmerge_keyring_setup "${vshome}" "verify-signature" && \
			GNUPGHOME="${vshome}" gpg --batch --quick-gen-key --pinentry-mode loopback \
			--passphrase '' 'local' ed25519 sign 0 >/dev/null 2>&1 ; then
		vskey=$(GNUPGHOME="${vshome}" gpg --batch --list-keys --with-colons \
			| awk -F: '/^fpr/{print $10; exit}')
		qmerge_keyring_ready "${vshome}"

		for vsr in vsyes vsno vsdef ; do
			mkdir -p "${ROOT}/${vsr}/sys-devel" \
				"cfg-${vsr}/etc/portage/binrepos.conf"
			cp "${vsgpkg}" "${ROOT}/${vsr}/sys-devel/${vspv}.gpkg.tar"
			env PKGDIR="/${vsr}" qmaint binhost -f >/dev/null 2>&1
		done
		printf '[vsyes]\npriority = 1\nlocation = /vsyes\nsync-uri = http://127.0.0.1:1/\nverify-signature = true\n' \
			> cfg-vsyes/etc/portage/binrepos.conf/r.conf
		printf '[vsno]\npriority = 1\nlocation = /vsno\nsync-uri = http://127.0.0.1:1/\nverify-signature = false\n' \
			> cfg-vsno/etc/portage/binrepos.conf/r.conf
		printf '[vsdef]\npriority = 1\nlocation = /vsdef\nsync-uri = http://127.0.0.1:1/\n' \
			> cfg-vsdef/etc/portage/binrepos.conf/r.conf
		rm -f "${vsgpkg}"
		qmaint binhost -f >/dev/null 2>&1

		out=$(yes | env PORTAGE_CONFIGROOT="${PWD}/cfg-vsyes" \
			qmerge -Fv =${vspv} 2>&1); rc=$?
		[[ ${rc} -ne 0 && ${out} == *"carries no OpenPGP signature"* && \
		   ${out} == *"refusing to merge"* && -z $(qlist -Iv 2>/dev/null) ]]
		tend $? "qmerge-test: verify-signature: repo true refuses unsigned" \
			|| die "rc=${rc}; ${out}"

		out=$(yes | env PORTAGE_CONFIGROOT="${PWD}/cfg-vsyes" \
			FEATURES='config-protect-if-modified binpkg-ignore-signature' \
			qmerge -Fv =${vspv} 2>&1); rc=$?
		[[ ${rc} -eq 0 && -n $(qlist -Iv 2>/dev/null) ]]
		tend $? "qmerge-test: verify-signature: ignore-signature overrides repo true" \
			|| die "rc=${rc}; ${out}"
		yes | qmerge -FU qmerge-test >/dev/null 2>&1

		out=$(yes | env PORTAGE_CONFIGROOT="${PWD}/cfg-vsno" \
			qmerge -Fv =${vspv} 2>&1); rc=$?
		[[ ${rc} -eq 0 && -n $(qlist -Iv 2>/dev/null) ]]
		tend $? "qmerge-test: verify-signature: repo false merges unsigned" \
			|| die "rc=${rc}; ${out}"
		yes | qmerge -FU qmerge-test >/dev/null 2>&1

		out=$(yes | env PORTAGE_CONFIGROOT="${PWD}/cfg-vsno" \
			FEATURES='config-protect-if-modified binpkg-request-signature' \
			qmerge -Fv =${vspv} 2>&1); rc=$?
		[[ ${rc} -ne 0 && ${out} == *"carries no OpenPGP signature"* && \
		   ${out} == *"refusing to merge"* && -z $(qlist -Iv 2>/dev/null) ]]
		tend $? "qmerge-test: verify-signature: request-signature overrides repo false" \
			|| die "rc=${rc}; ${out}"

		out=$(yes | env PORTAGE_CONFIGROOT="${PWD}/cfg-vsdef" \
			qmerge -Fv =${vspv} 2>&1); rc=$?
		[[ ${rc} -eq 0 && -n $(qlist -Iv 2>/dev/null) ]]
		tend $? "qmerge-test: verify-signature: unset repo merges unsigned (verify-if-present)" \
			|| die "rc=${rc}; ${out}"
		yes | qmerge -FU qmerge-test >/dev/null 2>&1

		env BINPKG_GPG_SIGNING_GPG_HOME="${vshome}" \
			BINPKG_GPG_SIGNING_KEY="${vskey}" \
			BINPKG_GPG_SIGNING_BASE_COMMAND='gpg --sign --armor [PORTAGE_CONFIG]' \
			qgpkg-sign "${ROOT}/vsyes/sys-devel/${vspv}.gpkg.tar" >/dev/null 2>&1
		env PKGDIR=/vsyes qmaint binhost -f >/dev/null 2>&1
		out=$(yes | env PORTAGE_CONFIGROOT="${PWD}/cfg-vsyes" \
			BINPKG_GPG_VERIFY_GPG_HOME="${vshome}" \
			qmerge -Fv =${vspv} 2>&1); rc=$?
		[[ ${rc} -eq 0 && -n $(qlist -Iv 2>/dev/null) ]]
		tend $? "qmerge-test: verify-signature: qgpkg-sign output merges via repo true" \
			|| die "rc=${rc}; ${out}"
		yes | qmerge -FU qmerge-test >/dev/null 2>&1

		# openpgp-key-package: per-repo trust-anchor attribute tests
		vk_craft() {
			local vkname=$1
			mkdir -p "vk-${vkname}/xp"
			(
				cd "vk-${vkname}"
				cp "${ROOT}/packages/sys-devel/qmerge-test-1.3.tbz2" b.tbz2
				qtbz2 -s b.tbz2 >/dev/null
				( cd xp && qxpak -x ../b.xpak >/dev/null )
				echo dev-libs > xp/CATEGORY
				echo "${vkname}-1.0" > xp/PF
				echo 0 > xp/SLOT
				echo 'amd64 arm64' > xp/KEYWORDS
				: > xp/RDEPEND
				rm -f xp/CHOST
				( cd xp && rm -f ./*.ebuild; touch "${vkname}-1.0.ebuild"
				  qxpak -c ../new.xpak $(ls) )
				mkdir -p "${ROOT}/pkgs/dev-libs"
				qtbz2 -j b.tar.bz2 new.xpak \
					"${ROOT}/pkgs/dev-libs/${vkname}-1.0.tbz2"
			)
			rm -rf "vk-${vkname}"
		}
		vk_craft keyanchor
		vk_craft otherpkg
		qmaint binhost -f >/dev/null 2>&1
		mkdir -p cfg-vskp/etc/portage/binrepos.conf \
			cfg-vskn/etc/portage/binrepos.conf
		printf '[vskp]\npriority = 1\nlocation = /vsyes\nsync-uri = http://127.0.0.1:1/\nverify-signature = true\nopenpgp-key-package = dev-libs/keyanchor\n' \
			> cfg-vskp/etc/portage/binrepos.conf/r.conf
		printf '[vskn]\npriority = 1\nlocation = /vsdef\nsync-uri = http://127.0.0.1:1/\nopenpgp-key-package = dev-libs/keyanchor\n' \
			> cfg-vskn/etc/portage/binrepos.conf/r.conf

		out=$(env PORTAGE_CONFIGROOT="${PWD}/cfg-vskp" \
			qmerge --repos -v 2>&1)
		[[ ${out} == *"openpgp-key-package: dev-libs/keyanchor"* ]]
		tend $? "qmerge-test: verify-signature: openpgp-key-package parsed and listed" \
			|| die "${out}"

		out=$(env PORTAGE_CONFIGROOT="${PWD}/cfg-vskp" \
			qmerge -p dev-libs/otherpkg dev-libs/keyanchor 2>&1); rc=$?
		vkfirst=$(printf '%s\n' "${out}" | grep -o 'dev-libs/[a-z]*-1\.0' | head -1)
		[[ ${rc} -eq 0 && ${vkfirst} == "dev-libs/keyanchor-1.0" ]]
		tend $? "qmerge-test: verify-signature: key package promoted first when signatures mandatory" \
			|| die "rc=${rc} first='${vkfirst}'; ${out}"

		out=$(env PORTAGE_CONFIGROOT="${PWD}/cfg-vskn" \
			qmerge -pv dev-libs/otherpkg dev-libs/keyanchor 2>&1); rc=$?
		[[ ${rc} -eq 0 && ${out} != *"promoted to merge first"* ]]
		tend $? "qmerge-test: verify-signature: no promotion when signatures not mandatory" \
			|| die "rc=${rc}; ${out}"

		out=$(qmerge -pv dev-libs/otherpkg dev-libs/keyanchor 2>&1); rc=$?
		[[ ${rc} -eq 0 && ${out} != *"promoted to merge first"* ]]
		tend $? "qmerge-test: verify-signature: no promotion without the attribute" \
			|| die "rc=${rc}; ${out}"

		rm -rf "${ROOT}/pkgs/dev-libs" cfg-vskp cfg-vskn
		gpgconf --homedir "${vshome}" --kill all >/dev/null 2>&1
		rm -rf "${vshome}" "${ROOT}/vsyes" "${ROOT}/vsno" "${ROOT}/vsdef" \
			cfg-vsyes cfg-vsno cfg-vsdef "${vsroot}/qmerge-test"
		qmaint binhost -f >/dev/null 2>&1
	else
		echo "${WARN}SKIPPED:${NORMAL} verify-signature: gpg cannot generate a test key"
		rm -rf "${vshome}" "${vsroot}/qmerge-test"
	fi
else
	echo "${WARN}SKIPPED:${NORMAL} verify-signature: checks (need gpkg + gpgme builds and gpg installed)"
fi

# [xattr] xattr + gpkg: qpkg -g must record xattrs (pax image) and the
# merge must restore them
if [[ -n ${GPKG_ENABLED} ]] && type -P setfattr >/dev/null \
		&& type -P getfattr >/dev/null ; then
	xaroot="${ROOT}/pkgs/sys-devel"
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -rf "${xaroot}/qmerge-test"
	rm -f "${xaroot}"/qmerge-test-1.3*.tbz2 "${xaroot}"/qmerge-test-1.3*.gpkg.tar
	qtbz2 -j ${f} ${pkgver}.xpak "${xaroot}/qmerge-test-1.3.tbz2"
	yes | qmerge -Fv =qmerge-test-1.3 >/dev/null 2>&1
	if setfattr -n user.qa -v xa-roundtrip \
			"${ROOT}/usr/bin/qmerge-test" 2>/dev/null ; then
		qpkg -g qmerge-test-1.3 >/dev/null 2>&1
		yes | qmerge -FU qmerge-test >/dev/null 2>&1
		rm -f "${xaroot}/qmerge-test-1.3.tbz2"
		out=$(yes | qmerge -Fv =qmerge-test-1.3 2>&1)
		tend $? "qmerge-test: [xattr] merge from xattr-carrying gpkg" || die "${out}"
		xaval=$(getfattr --only-values -n user.qa \
			"${ROOT}/usr/bin/qmerge-test" 2>/dev/null)
		[[ ${xaval} == "xa-roundtrip" ]]
		tend $? "qmerge-test: [xattr] user xattr survived qpkg+merge roundtrip" \
			|| die "got '${xaval}'; ${out}"
		if setfattr -n user.qraw -v 0xfffe80ff \
				"${ROOT}/usr/bin/qmerge-test" 2>/dev/null ; then
			rm -f "${xaroot}"/qmerge-test-1.3*.gpkg.tar
			qpkg -g qmerge-test-1.3 >/dev/null 2>&1
			gnew="${xaroot}/qmerge-test-1.3.gpkg.tar"
			touch -d "@$(( $(stat -c %Y "${gnew}") + 2 ))" "${gnew}"
			q --root "${ROOT}" qmaint binhost -f >/dev/null 2>&1
			yes | qmerge -FU qmerge-test >/dev/null 2>&1
			out=$(yes | qmerge -Fv =qmerge-test-1.3 2>&1)
			xaraw=$(getfattr -e hex -n user.qraw --absolute-names \
				"${ROOT}/usr/bin/qmerge-test" 2>/dev/null \
				| grep -o '0x[0-9a-f]*')
			[[ ${xaraw} == "0xfffe80ff" ]]
			tend $? "qmerge-test: [xattr] non-UTF-8 xattr value survives byte-exact" \
				|| die "got '${xaraw}'; ${out}"
			rm -f "${xaroot}"/qmerge-test-1.3*.gpkg.tar.checksum_failure
		else
			echo "${WARN}SKIPPED:${NORMAL} [xattr] filesystem rejects binary xattr values"
		fi
		yes | qmerge -FU qmerge-test >/dev/null 2>&1
	else
		echo "${WARN}SKIPPED:${NORMAL} [xattr] filesystem rejects user xattrs"
		yes | qmerge -FU qmerge-test >/dev/null 2>&1
		rm -f "${xaroot}/qmerge-test-1.3.tbz2"
	fi
	rm -rf "${xaroot}/qmerge-test"
else
	echo "${WARN}SKIPPED:${NORMAL} [xattr] needs gpkg + setfattr/getfattr"
fi

# [FWF] gpkg, same as the .xpak and .tbz2 tests,
# we need to check that the whole gpkg payload is safe
# and that includes the image.tar.zst
if [[ -n ${GPKG_ENABLED} ]] && type -P zstd >/dev/null ; then
	ffgroot="${ROOT}/pkgs/sys-devel"
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -rf "${ffgroot}/qmerge-test"
	rm -f "${ffgroot}"/qmerge-test-1.3*.tbz2 "${ffgroot}"/qmerge-test-1.3*.gpkg.tar
	qtbz2 -j ${f} ${pkgver}.xpak "${ffgroot}/qmerge-test-1.3.tbz2"
	yes | qmerge -Fv =qmerge-test-1.3 >/dev/null 2>&1
	qpkg -g qmerge-test-1.3 >/dev/null 2>&1
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -f "${ffgroot}/qmerge-test-1.3.tbz2"
	ffg=$(find "${ffgroot}" -type f \
		\( -name 'qmerge-test-1.3.gpkg.tar' \
		   -o -name 'qmerge-test-1.3-*.gpkg.tar' \) | head -1)
	ffgpfx=$(tar tf "${ffg}" | head -1); ffgpfx=${ffgpfx%%/*}
	rm -rf ffgref; mkdir -p ffgref
	tar xOf "${ffg}" "${ffgpfx}/image.tar.zst" | zstd -dc | tar xp -C ffgref
	[[ -s ffgref/image/usr/bin/qmerge-test && -s ffgref/image/etc/some.conf ]]
	tend $? "qmerge-test: [FWF] gpkg image payload unpacked independently and retained" \
		|| die "$(find ffgref 2>&1)"

	q --root "${ROOT}" qmaint binhost -f >/dev/null 2>&1
	out=$(yes | qmerge -Fv =qmerge-test-1.3 2>&1)
	tend $? "qmerge-test: [FWF] gpkg install for file-with-file compare" || die "${out}"

	ffgbad=""
	while IFS= read -r ffp ; do
		ffrel=${ffp#ffgref/image/}
		ffdst="${ROOT}/${ffrel}"
		if [[ -L ${ffp} ]] ; then
			[[ -L ${ffdst} && \
			   $(readlink "${ffp}") == "$(readlink "${ffdst}")" ]] \
				|| ffgbad+="symlink:${ffrel} "
		elif [[ -d ${ffp} ]] ; then
			[[ -d ${ffdst} ]] || ffgbad+="dir:${ffrel} "
		else
			cmp -s "${ffp}" "${ffdst}" || ffgbad+="content:${ffrel} "
		fi
	done < <(find ffgref/image -mindepth 1)
	[[ -z ${ffgbad} ]]
	tend $? "qmerge-test: [FWF] gpkg: every package file matches installed (content+symlink)" \
		|| die "mismatches: ${ffgbad}"

	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -rf ffgref "${ffgroot}/qmerge-test"
	rm -f "${ffgroot}"/qmerge-test-1.3*.gpkg.tar
	qmaint binhost -f >/dev/null 2>&1
else
	echo "${WARN}SKIPPED:${NORMAL} [FWF] gpkg file-with-file (need gpkg + zstd)"
fi

# [TB] tbz2 builder -> image written via libarchive (external
# tar eliminated from production). External tar cmd is still used below to
# cross-check the produced tbz2 image, as a second implementation that
# shares no code with ours
tbroot="${ROOT}/pkgs/sys-devel"
tbvdb="${ROOT}/var/db/pkg/sys-devel/qmerge-test-1.3"
yes | qmerge -FU qmerge-test >/dev/null 2>&1
rm -rf "${tbroot}/qmerge-test"
rm -f "${tbroot}"/qmerge-test-1.3*.tbz2 "${tbroot}"/qmerge-test-1.3*.gpkg.tar
qtbz2 -j ${f} ${pkgver}.xpak "${tbroot}/qmerge-test-1.3.tbz2"
yes | qmerge -Fv =qmerge-test-1.3 >/dev/null 2>&1
qm_merged "sys-devel/qmerge-test-1.3" "[TB] test package merged for rebuild"

tbref=$(md5sum "${ROOT}/usr/bin/qmerge-test" | cut -d' ' -f1)
ln "${ROOT}/usr/bin/qmerge-test" "${ROOT}/usr/bin/qmerge-test.hl"
tbmt=$(stat -c %Y "${ROOT}/usr/bin/qmerge-test.hl")
echo "obj /usr/bin/qmerge-test.hl ${tbref} ${tbmt}" >> "${tbvdb}/CONTENTS"
rm -f "${tbroot}"/qmerge-test-1.3*.tbz2
out=$(PORTAGE_BINPKG_TAR_OPTS="--xattrs --xattrs-include=*" \
	qpkg -x qmerge-test-1.3 2>&1); rc=$?
[[ ${rc} -eq 0 && -s ${tbroot}/qmerge-test-1.3.tbz2 && \
   ${out} != *"not supported"* ]]
tend $? "qmerge-test: [TB] qpkg -x builds, known tar opts silent" \
	|| die "${out}"

rm -rf tbsplit
mkdir -p tbsplit
( cd tbsplit && qtbz2 -s "${tbroot}/qmerge-test-1.3.tbz2" ) >/dev/null 2>&1
tar jtf tbsplit/qmerge-test-1.3.tar.bz2 | sed 's:/$::' | \
	LC_ALL=C sort > tb.tar.lst
awk '$1 == "obj" || $1 == "dir" || $1 == "sym" { print substr($2, 2) }' \
	"${tbvdb}/CONTENTS" | LC_ALL=C sort > tb.vdb.lst
diff -u tb.vdb.lst tb.tar.lst
tend $? "qmerge-test: [TB] external tar reads the image, member set equals CONTENTS" \
	|| die "$(cat tb.vdb.lst tb.tar.lst)"

yes | qmerge -FU qmerge-test >/dev/null 2>&1
qm_unmerged "sys-devel/qmerge-test" "[TB] test package unmerged before remerge"
out=$(yes | qmerge -Fv =qmerge-test-1.3 2>&1); rc=$?
[[ ${rc} -eq 0 ]]
tend $? "qmerge-test: [TB] merge back from the tbz2" || die "${out}"
qm_merged "sys-devel/qmerge-test-1.3" "[TB] remerge really landed"
[[ $(md5sum "${ROOT}/usr/bin/qmerge-test" | cut -d' ' -f1) == "${tbref}" ]]
tend $? "qmerge-test: [TB] payload byte-identical after roundtrip" \
	|| die "$(md5sum "${ROOT}/usr/bin/qmerge-test")"
[[ $(stat -c %i "${ROOT}/usr/bin/qmerge-test") == \
   "$(stat -c %i "${ROOT}/usr/bin/qmerge-test.hl")" && \
   $(stat -c %h "${ROOT}/usr/bin/qmerge-test") -ge 2 ]]
tend $? "qmerge-test: [TB] hardlink pair preserved (same inode)" \
	|| die "$(stat "${ROOT}/usr/bin/qmerge-test" \
			"${ROOT}/usr/bin/qmerge-test.hl" 2>&1)"

if type -P setfattr >/dev/null && type -P getfattr >/dev/null && \
		setfattr -n user.qtb -v tb-roundtrip \
			"${ROOT}/usr/bin/qmerge-test" 2>/dev/null ; then
	rm -f "${tbroot}"/qmerge-test-1.3*.tbz2
	qpkg -x qmerge-test-1.3 >/dev/null 2>&1
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	out=$(yes | qmerge -Fv =qmerge-test-1.3 2>&1)
	tbxa=$(getfattr --only-values -n user.qtb \
		"${ROOT}/usr/bin/qmerge-test" 2>/dev/null)
	[[ ${tbxa} == "tb-roundtrip" ]]
	tend $? "qmerge-test: [TB] user xattr survives the tbz2 roundtrip" \
		|| die "got '${tbxa}'; ${out}"
else
	echo "${WARN}SKIPPED:${NORMAL} [TB] xattr roundtrip (no setfattr/getfattr or fs support)"
fi

rm -f "${tbroot}"/qmerge-test-1.3*.tbz2
out=$(PORTAGE_BINPKG_TAR_OPTS="--bogus-flag" qpkg -x qmerge-test-1.3 2>&1)
rc=$?
rm -rf tbsplit
mkdir -p tbsplit
( cd tbsplit && qtbz2 -s "${tbroot}/qmerge-test-1.3.tbz2" ) >/dev/null 2>&1
[[ ${rc} -eq 0 && ${out} == *"'--bogus-flag' not supported"* && \
   -s ${ROOT}/packages/sys-devel/qmerge-test-1.3.tbz2 ]] && \
	tar jtf tbsplit/qmerge-test-1.3.tar.bz2 >/dev/null
tend $? "qmerge-test: [TB] unknown tar opt warned and ignored, package still valid" \
	|| die "rc=${rc}; ${out}"

# The brotli path is the one that used to shell out to tar with no
# libarchive protections.
# it now extracts through archive_write_disk with the SECURE_ flags, 
# so a hostile member must not escape the image dir.
if tar --version 2>/dev/null | grep -qi 'GNU tar' && \
		type -P brotli >/dev/null ; then
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -rf tbcorrpt
	mkdir -p tbcorrpt
	echo canary > tbcorrpt/qmerge-corrpt-abs
	tar -C tbcorrpt -P --transform 's:^:/:' -cf tbcorrpt.tar qmerge-corrpt-abs
	brotli -c tbcorrpt.tar > tbcorrpt.tar.br
	qtbz2 -j tbcorrpt.tar.br ${pkgver}.xpak "${tbroot}/qmerge-test-1.3-r99.tbz2"
	out=$(yes | qmerge -Fv =qmerge-test-1.3-r99 2>&1); rc=$?
	[[ ${rc} -ne 0 && ! -e /qmerge-corrpt-abs && \
	   -z $(qlist -Iv 2>/dev/null | grep qmerge-test) ]]
	tend $? "qmerge-test: [TB] brotli tbz2 with absolute member refused" \
		|| die "rc=${rc}; ${out}"
	rm -f "${tbroot}/qmerge-test-1.3-r99.tbz2" tbcorrpt.tar tbcorrpt.tar.br
	rm -rf tbcorrpt

	# symlink escape: a member written THROUGH a symlink pointing at a dir
	# we own outside the image must be refused (SECURE_SYMLINKS). The
	# "sentinel" dir is an absolute path, so a real escape is directly verifiable.
	yes | qmerge -FU qmerge-test >/dev/null 2>&1
	rm -rf tbsym "${PWD}/tb-sentinel"
	mkdir -p tbsym/stage "${PWD}/tb-sentinel"
	ln -s "${PWD}/tb-sentinel" tbsym/stage/esc
	tar -cf tbsym.tar -C tbsym/stage esc
	echo pwned > tbsym/pwned
	tar --append -f tbsym.tar -C tbsym \
		--transform 's:^pwned$:esc/qmerge-corrpt-sym:' pwned
	brotli -c tbsym.tar > tbsym.tar.br
	qtbz2 -j tbsym.tar.br ${pkgver}.xpak "${tbroot}/qmerge-test-1.3-r99.tbz2"
	out=$(yes | qmerge -Fv =qmerge-test-1.3-r99 2>&1); rc=$?
	[[ ${rc} -ne 0 && ! -e ${PWD}/tb-sentinel/qmerge-corrpt-sym && \
	   -z $(qlist -Iv 2>/dev/null | grep qmerge-test) ]]
	tend $? "qmerge-test: [TB] brotli tbz2 symlink escape refused" \
