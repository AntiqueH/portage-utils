[[ ${rcdc} -eq 0 && $(echo "${outdc}" | dc_sel) == "dc-libs/A-1" ]]
tend $? "qmerge-test: [DC] prune: a world-pinned old slot still goes" \
	|| die "rc=${rcdc} ${outdc}"
outdc=$(qmerge -pP --deselect=n 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 && $(echo "${outdc}" | dc_sel) == "" ]]
tend $? "qmerge-test: [DC] prune --deselect=n: the world entry keeps the old slot" \
	|| die "rc=${rcdc} ${outdc}"

