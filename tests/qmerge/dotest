echo bin > "${ROOT}/usr/share/dc/dcs"
dcmd=$(md5sum "${ROOT}/usr/share/dc/dcs" | cut -d' ' -f1)
echo "obj /usr/share/dc/dcs ${dcmd} 1" >> "${ROOT}/var/db/pkg/dc-libs/S-1/CONTENTS"
printf 'X86_64;/usr/share/dc/dcs;;;libdcn.so.1;x86_64\n' > "${ROOT}/var/db/pkg/dc-libs/S-1/NEEDED.ELF.2"
