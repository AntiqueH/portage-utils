tend $? "qmerge-test: [DC] prune run: the world entry of the pruned slot dropped, log 1+1" \
	|| die "$(cat "${ROOT}/var/lib/portage/world") --- $(cat "${ROOT}/dclog/emerge.log")"
outdc=$(qmerge -pP 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 && $(echo "${outdc}" | dc_sel) == "" ]]
tend $? "qmerge-test: [DC] prune run: converged" || die "rc=${rcdc} ${outdc}"

# --prune --nodeps
