# FEATURES=preserve-libs tests. registry preservation, @preserved-rebuild,
# GC, and the soname usage testssweep
PLFEAT="config-protect-if-modified preserve-libs"
mkpl() {
	local pf=$1 needed=$2 provides=$3 requires=$4 rdep=$5
	shift 5
	local d="pl_${pf}"
	mkdir -p "${d}/xp" "${d}/img"
	(
		cd "${d}"
		local f
		for f in "$@"; do
			case ${f} in
			*'<='*)
				mkdir -p "img/$(dirname "${f%%<=*}")"
				cp "${f##*<=}" "img/${f%%<=*}"
				;;
			*'->'*)
				mkdir -p "img/$(dirname "${f%%->*}")"
				ln -s "${f##*->}" "img/${f%%->*}"
				;;
			*)
				mkdir -p "img/$(dirname "${f}")"
				echo "${pf}" > "img/${f}"
				;;
			esac
		done
		tar cjf image.tar.bz2 -C img .
		echo dev-libs > xp/CATEGORY
		echo "${pf}" > xp/PF
		echo 0 > xp/SLOT
		echo 8 > xp/EAPI
		printf '%s' "${rdep}" > xp/RDEPEND
		[[ -n ${needed} ]] && printf '%b\n' "${needed}" > xp/NEEDED.ELF.2
		[[ -n ${provides} ]] && printf '%s\n' "${provides}" > xp/PROVIDES
		[[ -n ${requires} ]] && printf '%s\n' "${requires}" > xp/REQUIRES
		( cd xp && touch "${pf}.ebuild"; qxpak -c ../new.xpak $(ls) )
		mkdir -p "${ROOT}/packages/dev-libs"
		qtbz2 -j image.tar.bz2 new.xpak \
			"${ROOT}/packages/dev-libs/${pf}.tbz2"
	)
}

