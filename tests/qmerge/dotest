   ${outdc} != *"  dc-libs/A-2 pulled in by:"* ]]
tend $? "qmerge-test: [DC] prune -v: the revdep reason, nothing shown for the protected highest" \
	|| die "${outdc}"
printf 'dc-libs/A\n' > "${ROOT}/var/db/pkg/dc-libs/B-1/RDEPEND"
outdc=$(qmerge -pP 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 && $(echo "${outdc}" | dc_sel) == "dc-libs/A-1" && \
   ${outdc} == *"protected: "*"2"* ]]
tend $? "qmerge-test: [DC] prune: the unneeded old slot is selected, the highest protected" \
	|| die "rc=${rcdc} ${outdc}"
outdc=$(qmerge -pP dc-libs/B 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 && $(echo "${outdc}" | dc_sel) == "" && \
   ${outdc} == *">>> No packages selected for removal by prune"* ]]
tend $? "qmerge-test: [DC] prune: a single-version argument selects nothing" \
	|| die "rc=${rcdc} ${outdc}"
outdc=$(qmerge -pP dc-libs/none 2>&1); rcdc=$?
[[ ${rcdc} -ne 0 && ${outdc} == *"--- Couldn't find 'dc-libs/none' to prune."* && \
   ${outdc} == *">>> No packages selected for removal by prune"* ]]
tend $? "qmerge-test: [DC] prune: an unknown argument is reported with the prune wording" \
	|| die "rc=${rcdc} ${outdc}"

