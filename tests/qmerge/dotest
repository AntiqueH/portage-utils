dc_reset() {
	rm -rf "${ROOT}/var/db/pkg" "${ROOT}/usr/share/dc" "${ROOT}/usr/lib/dc"
	mkdir -p "${ROOT}/var/db/pkg" "${ROOT}/var/lib/portage"
	: > "${ROOT}/var/lib/portage/world"
	rm -f "${ROOT}/var/lib/portage/world_sets"
}

# $1 cat/pn-ver  $2 SLOT  $3 RDEPEND  $4 DEPEND  $5 IDEPEND  $6 KEYWORDS
dc_vdb() {
	local d="${ROOT}/var/db/pkg/$1" f="${1#*/}" md
	mkdir -p "${d}" "${ROOT}/usr/share/dc"
	echo "${2:-0}" > "${d}/SLOT"
	printf '%s\n' "$3" > "${d}/RDEPEND"
	printf '%s\n' "$4" > "${d}/DEPEND"
	printf '%s\n' "$5" > "${d}/IDEPEND"
	echo "${6:-amd64}" > "${d}/KEYWORDS"
	echo 8 > "${d}/EAPI"
	: > "${d}/USE"
	: > "${d}/IUSE"
	echo "${1%/*}" > "${d}/CATEGORY"
	echo "${f}" > "${d}/PF"
	echo 1 > "${d}/COUNTER"
	echo "$1" > "${ROOT}/usr/share/dc/${f}"
	md=$(md5sum "${ROOT}/usr/share/dc/${f}" | cut -d' ' -f1)
	echo "obj /usr/share/dc/${f} ${md} 1" > "${d}/CONTENTS"
}
dc_world() { printf '%s\n' "$@" > "${ROOT}/var/lib/portage/world"; }

# the selected list of a -pc run, space separated cpvs, closest packages only
dc_sel() {
	sed -n 's/^All selected packages://p' | tr ' ' '\n' | sed -n 's/^=\(dc-.*\)/\1/p' | tr '\n' ' ' | sed 's/ $//'
}

