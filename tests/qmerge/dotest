export PKGDIR=/packages
cp "${ROOT}/packages/sys-devel/qmerge-test-1.3.tbz2" "${PORTAGE_TMPDIR}/reidx-base.tbz2"
q --root "${ROOT}" qmaint binhost -f >/dev/null 2>&1
btkey() {
