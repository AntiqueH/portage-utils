# the --prune (emerge -P) tests.
#
# yes, there's more
#
# every installed cp is a root, check if the highest version of
# each cp is protected by =cpv, while the other versions matched by the arguments
# (all multi-version cps by default) go when nothing installed needs them
dc_reset
dc_vdb dc-libs/A-1 1 "" && dc_vdb dc-libs/A-2 2 "" && dc_vdb dc-libs/B-1 0 "dc-libs/A:1"
dc_world dc-libs/A dc-libs/B
