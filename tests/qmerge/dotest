printf '=dc-libs/A-2\n' > "${PWD}/cfgpr/etc/portage/package.mask"
outdc=$(env PORTAGE_CONFIGROOT="${PWD}/cfgpr" qmerge -pP 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 && $(echo "${outdc}" | dc_sel) == "" ]]
