		echo 'amd64' > xp/KEYWORDS
		: > xp/RDEPEND
		( cd xp && rm -f ./*.ebuild; touch "$2.ebuild"
		  qxpak -c ../new.xpak $(ls) >/dev/null )
		mkdir -p "${ROOT}/packages/$1"
		qtbz2 -j b.tar.bz2 new.xpak "${ROOT}/packages/$1/$2.tbz2"
	)
