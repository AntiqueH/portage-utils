# package moves (our implementation of updates: a signed gpkg survives a
# move byte-identical, signature intact 
# We have a divergence with portage here: portage rewrites unsigned binpkgs
# on moves and DELETES signed ones, while our updates (called moves) touch VDB, VDB deps and world only)
if [[ -n ${GPKG_ENABLED} ]] && type -P gpg >/dev/null ; then
	ac_craft mvpkg ""
	qmaint binhost -f >/dev/null 2>&1
	yes | qmerge -Fv "=dev-libs/mvpkg-1.0" >/dev/null 2>&1
	outqp=$(qpkg -g mvpkg-1.0 2>&1)
	[[ ${outqp} == *">>> Creating binpkg"* ]]
	tend $? "qmerge-test: [qpkg] '>>> Creating binpkg' logged when building" \
		|| die "${outqp}"
	rm -f "${acstore}/dev-libs/mvpkg-1.0.tbz2"
	mvg=$(find "${acstore}/dev-libs" -name 'mvpkg-1.0*.gpkg.tar' | head -1)

	mvhome="${PWD}/mv-gnupg"
	rm -rf "${mvhome}"; mkdir -m 700 "${mvhome}"
	if [[ -n ${mvg} ]] && GNUPGHOME="${mvhome}" gpg --batch --quick-gen-key \
			--pinentry-mode loopback --passphrase '' 'local' ed25519 sign 0 \
			>/dev/null 2>&1 ; then
		mvkey=$(GNUPGHOME="${mvhome}" gpg --batch --list-keys --with-colons \
			| awk -F: '/^fpr/{print $10; exit}')
		env BINPKG_GPG_SIGNING_GPG_HOME="${mvhome}" \
			BINPKG_GPG_SIGNING_KEY="${mvkey}" \
			BINPKG_GPG_SIGNING_BASE_COMMAND='gpg --sign --armor [PORTAGE_CONFIG]' \
			qgpkg-sign "${mvg}" >/dev/null 2>&1
		qmaint binhost -f >/dev/null 2>&1
		cp "${mvg}" "${PWD}/mv.ref"

		mkdir -p "${ROOT}/mvstore" cfg-mv/etc/portage/binrepos.conf
		printf '[mvrepo]\npriority = 1\nlocation = /mvstore\nsync-uri = http://127.0.0.1:1/\n' \
			> cfg-mv/etc/portage/binrepos.conf/r.conf
		printf 'move dev-libs/mvpkg dev-libs/mvmoved\n' > "${ROOT}/mvstore/Moves"
		out=$(env PORTAGE_CONFIGROOT="${PWD}/cfg-mv" QMERGE_MOVES=binhost-only \
			qmerge -f 2>&1)

		[[ -d ${ROOT}/var/db/pkg/dev-libs/mvmoved-1.0 && \
		   ! -d ${ROOT}/var/db/pkg/dev-libs/mvpkg-1.0 ]]
		tend $? "qmerge-test: signed-binpkg move: VDB entry renamed" \
			|| die "$(ls "${ROOT}/var/db/pkg/dev-libs" 2>&1); ${out}"

		cmp -s "${mvg}" "${PWD}/mv.ref"
		tend $? "qmerge-test: signed-binpkg move: container byte-untouched" \
			|| die "container changed; ${out}"

		mvpfx=$(tar tf "${mvg}" | head -1); mvpfx=${mvpfx%%/*}
		tar -xOf "${mvg}" "${mvpfx}/Manifest" > "${PWD}/mv.mchk" && \
			GNUPGHOME="${mvhome}" gpg --verify "${PWD}/mv.mchk" >/dev/null 2>&1
		tend $? "qmerge-test: signed-binpkg move: signature still verifies" \
			|| die "$(GNUPGHOME="${mvhome}" gpg --verify "${PWD}/mv.mchk" 2>&1)"

		[[ ${out} == *"no prebuilt"*"use emerge"* ]]
		tend $? "qmerge-test: signed-binpkg move: missing-new-name warning shown" \
			|| die "${out}"

		yes | qmerge -FU mvmoved >/dev/null 2>&1
	else
		echo "${WARN}SKIPPED:${NORMAL} signed-binpkg move: gpg cannot generate a test key"
	fi
	gpgconf --homedir "${mvhome}" --kill all >/dev/null 2>&1
	rm -rf "${mvhome}" "${acstore}/dev-libs" "${ROOT}/mvstore" cfg-mv
	rm -f "${PWD}/mv.ref" "${PWD}/mv.mchk"
	qmaint binhost -f >/dev/null 2>&1
else
	echo "${WARN}SKIPPED:${NORMAL} signed-binpkg move: checks (need a gpkg build and gpg installed)"
fi

