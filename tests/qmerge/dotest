	|| die "rc=${rcdc} ${outdc} $(cat "${ROOT}/dclog/emerge.log")"
qm_unmerged dc-libs/A "[DC] failure: the package removed before it is gone"
[[ -d ${ROOT}/var/db/pkg/dc-libs/B-1 ]]
tend $? "qmerge-test: [DC] failure: the failing package's vdb entry is left in place" \
