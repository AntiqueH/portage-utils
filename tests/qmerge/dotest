# slot operator: recorded := pins from installed revdeps drive rebuilt-revdep
# pulls, lenient/strict provider posture, and forward pinned selection
sostore="${ROOT}/sostore"
so_craft() {
	local soname=$1 sover=$2 soslot=$3 sordep=$4 sodest=$5 sobt=$6
	mkdir -p "so-${soname}/xp"
	(
		cd "so-${soname}"
		cp "${ROOT}/packages/sys-devel/qmerge-test-1.3.tbz2" b.tbz2
		qtbz2 -s b.tbz2 >/dev/null
		( cd xp && qxpak -x ../b.xpak >/dev/null )
		echo dev-libs > xp/CATEGORY
		echo "${soname}-${sover}" > xp/PF
		echo "${soslot}" > xp/SLOT
		echo 'amd64 arm64' > xp/KEYWORDS
		printf '%s\n' "${sordep}" > xp/RDEPEND
		echo "${sobt:-1700000000}" > xp/BUILD_TIME
		rm -f xp/CHOST
		( cd xp && rm -f ./*.ebuild; touch "${soname}-${sover}.ebuild"
		  qxpak -c ../new.xpak $(ls) )
		mkdir -p "$(dirname "${sostore}/${sodest}")"
		qtbz2 -j b.tar.bz2 new.xpak "${sostore}/${sodest}"
	)
	rm -rf "so-${soname}"
}

