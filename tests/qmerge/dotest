rm -rf "${ROOT}/dclog"; mkdir -p "${ROOT}/dclog"
outdc=$(yes | env EMERGE_LOG_DIR="${ROOT}/dclog" qmerge -P 2>&1); rcdc=$?
[[ ${rcdc} -eq 0 && ${outdc} == *">>> Unmerging (1 of 1) dc-libs/A-1..."* && \
   ${outdc} != *"Packages installed:"* && ${outdc} != *"Number removed"* ]]
tend $? "qmerge-test: [DC] prune run: rc 0, one progress line, no summary" \
	|| die "rc=${rcdc} ${outdc}"
qm_unmerged dc-libs/A-1 "[DC] prune run: the old slot unmerged"
qm_merged dc-libs/A-2 "[DC] prune run: the highest version intact"
qm_merged dc-libs/B-1 "[DC] prune run: the revdep intact"
[[ $(cat "${ROOT}/var/lib/portage/world") == "dc-libs/B" && \
   $(grep -c "=== Unmerging... (dc-libs/A-1)" "${ROOT}/dclog/emerge.log") -eq 1 && \
