   ${outa} != *"ignored due to non matching USE"* ]]
tend $? "qmerge-test: [S] check off accepts USE mismatch" || die "${outa}"

rm -f "${ROOT}/packages/sys-devel/qmerge-test-1.3-r50.tbz2"
q --root "${ROOT}" qmaint binhost -f >/dev/null 2>&1

# qmaint binhost full test a rebuilt binpkg (same version, new BUILD_TIME + new
