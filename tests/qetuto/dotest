#!/bin/bash

. ../init.sh || exit 1

mktmpdir

# qetuto drives gpg, gpgconf, openssl and timeout as external programs;
# the gpg agents do not get to valgrind
if [[ -n ${Q_RUN_WITH_VALGRIND} ]] ; then
	echo "${WARN}SKIPPED:${NORMAL} qetuto checks (valgrind active)"
	cleantmpdir
	exit 0
fi
for t in gpg gpgconf openssl timeout ; do
	if ! command -v ${t} >/dev/null 2>&1 ; then
		echo "${WARN}SKIPPED:${NORMAL} qetuto checks (${t} not installed)"
		cleantmpdir
		exit 0
	fi
done

set -e

export ROOT=${PWD}/root
export PORTAGE_CONFIGROOT=${PWD}
export HOME=${PWD}
export QETUTO_KEYS=/keys/release.asc
export QETUTO_KEYSERVERS=hkp://127.0.0.1:1
unset QETUTO_EXTERNAL_REFRESH
mkdir -p etc/portage root/keys

# sGentoo release keys, generated here and exported
# armored into one file
# UIDs carry no dott domain
export GNUPGHOME=${PWD}/gen
mkdir -m 700 gen
gpg --batch --quiet --passphrase '' --quick-generate-key \
	'Test Release <release@localhost>' default default never >/dev/null 2>&1
for i in $(seq 1 20) ; do
	gpg --batch --quiet --passphrase '' --quick-generate-key \
		"Extra Key ${i} <extra${i}@localhost>" ed25519 sign never >/dev/null 2>&1
done
fpr=$(gpg --batch --with-colons --list-keys release@localhost \
	| awk -F: '/^fpr:/ { print $10; exit }')
gpg --batch --quiet --armor --export > root/keys/release.asc
chmod 644 root/keys/release.asc
[[ $(gpg --batch --with-colons --list-keys | wc -c) -gt 4096 ]]
gpgconf --kill all >/dev/null 2>&1 || :
unset GNUPGHOME
[[ -n ${fpr} && -s root/keys/release.asc ]]
tpass "test release keys generated"

home=root/etc/portage/gnupg
keys() { gpg --homedir "${home}" --batch --with-colons --list-keys 2>/dev/null; }
agents_down() { gpgconf --homedir "${home}" --kill all >/dev/null 2>&1 || : ; }

# bootstrap the keyring under ROOT, vin erbose, with the external
# refresh activated so the keyserver and WKD steps run against the closed port
out=$(QETUTO_EXTERNAL_REFRESH=1 qetuto -C -v 2>/dev/null)
[[ ${out} == *"Initializing ${ROOT}/etc/portage/gnupg"* ]]
[[ -d ${home} && ! -e ${home}.getuto.tmp ]]
[[ -f ${home}/.getuto.last && -f ${home}/mykeyid && -f ${home}/pass ]]
[[ -f ${home}/trustdb.gpg && $(stat -c %a ${home}/pass) == 600 ]]
[[ -f ${home}/gpg.conf && -f ${home}/gpg-agent.conf && -f ${home}/dirmngr.conf ]]
tpass "bootstrap creates the keyring under ROOT"

[[ -z $(pgrep -f "gpg-agent --homedir ${ROOT}/etc/portage/gnupg.getuto.tmp") ]]
tpass "bootstrap leaves no gpg-agent on the staging directory"

mykeyid=$(<${home}/mykeyid)
[[ ${mykeyid} =~ ^[0-9A-F]{40}$ ]]
keys | grep -q "^fpr:::::::::${mykeyid}:"
keys | grep -q "^fpr:::::::::${fpr}:"
[[ $(keys | grep -c '^uid:.*<extra[0-9]*@localhost>') -eq 20 ]]
tpass "local trust key and all release keys are in the keyring"

# the release key is locally signed by the trust key: its pub record
# carries validity f once the trust db has been checked
[[ $(keys | awk -F: -v f="${fpr}" '$1 == "pub" { v = $2 } $1 == "fpr" && $10 == f { print v; exit }') == f ]]
tpass "release key locally signed and presumably valid"
agents_down

# second run within a day: nothing to do
# without a keyserver override the built-in list is constructed and the refresh is skipped
out=$(env -u QETUTO_KEYSERVERS qetuto -C -v 2>/dev/null)
[[ ${out} == *"already up-to-date"* ]]
tpass "refresh within a day is skipped"

# an old last run timestamp file triggers the refresh: the key file is
# re-imported and the last run timestamp file renewed; without
# QETUTO_EXTERNAL_REFRESH=1 no keyserver or WKD
touch -d '2 days ago' ${home}/.getuto.last
before=$(stat -c %Y ${home}/.getuto.last)
out=$(qetuto -C -v 2>/dev/null)
[[ ${out} == *"Updating GnuPG keyring"* ]]
[[ $(stat -c %Y ${home}/.getuto.last) -gt ${before} ]]
keys | grep -q "^fpr:::::::::${fpr}:"
tpass "old last run timestamp file triggers the refresh and is renewed"
agents_down

# external refresh -> the keyserver is unreachable, the run still ends
# cleanly and the last run timestamp file is renewed
touch -d '2 days ago' ${home}/.getuto.last
before=$(stat -c %Y ${home}/.getuto.last)
QETUTO_EXTERNAL_REFRESH=1 qetuto -C 2>/dev/null
[[ $(stat -c %Y ${home}/.getuto.last) -gt ${before} ]]
tpass "external refresh survives an unreachable keyserver"
agents_down

# every run ends by checking the keyring: check release key if it's gone
# or not signed by the local trust key, or a lost local trust key, is a
# failure
cp -a ${home} home.good
kval() { keys | awk -F: -v f="$1" \
	'$1 == "pub" { v = $2 } $1 == "fpr" && $10 == f { print v; exit }'; }

# if say we lost a release key, we should import from the key file
# and sign it again, even if the last run timestamp file is still valid
gpg --homedir ${home} --batch --yes --delete-keys ${fpr} >/dev/null 2>&1
agents_down
before=$(stat -c %Y ${home}/.getuto.last)
qetuto -C
[[ $(kval ${fpr}) == f && $(stat -c %Y ${home}/.getuto.last) -eq ${before} ]]
tpass "a removed release key is imported and signed again the same day"
agents_down

# if we add a key file into QEETUTO_KEYS after the keyring was made:
# we import and sign the new key
mkdir -m 700 gen2
GNUPGHOME=${PWD}/gen2 gpg --batch --quiet --passphrase '' \
	--quick-generate-key 'Later Key <later@localhost>' ed25519 sign never \
	>/dev/null 2>&1
fpr2=$(GNUPGHOME=${PWD}/gen2 gpg --batch --with-colons --list-keys \
	later@localhost | awk -F: '/^fpr:/ { print $10; exit }')
GNUPGHOME=${PWD}/gen2 gpg --batch --quiet --armor --export > root/keys/later.asc
chmod 644 root/keys/later.asc
gpgconf --homedir ${PWD}/gen2 --kill all >/dev/null 2>&1 || :
[[ -n ${fpr2} && -s root/keys/later.asc ]]
QETUTO_KEYS="/keys/release.asc /keys/later.asc" qetuto -C
[[ $(kval ${fpr2}) == f && $(kval ${fpr}) == f ]]
tpass "a key file added to QETUTO_KEYS later is imported and signed"
agents_down

# QETUTO_EXTRA_KEYS adds its files to the ones of QETUTO_KEYS.
# both the base key and the extra key(s) are cared for.
# at least that's what we're testing
rm -rf ${home}
cp -a home.good ${home}
gpg --homedir ${home} --batch --yes --delete-keys ${fpr} >/dev/null 2>&1
agents_down
[[ -z $(kval ${fpr}) && -z $(kval ${fpr2}) ]]
QETUTO_EXTRA_KEYS="/keys/later.asc" qetuto -C
[[ $(kval ${fpr2}) == f && $(kval ${fpr}) == f ]]
tpass "QETUTO_EXTRA_KEYS adds its key files to those of QETUTO_KEYS"
agents_down

# test key file changed after the last run (a new user id here, in real
# life a new subkey or a revocation) is imported the same day, and the
# last run timestamp file we leave it alone
before=$(stat -c %Y ${home}/.getuto.last)
GNUPGHOME=${PWD}/gen gpg --batch --quiet --passphrase '' \
	--pinentry-mode loopback --quick-add-uid ${fpr} \
	'Renewed <renewed@localhost>' >/dev/null 2>&1
GNUPGHOME=${PWD}/gen gpg --batch --quiet --armor --export > root/keys/release.asc
chmod 644 root/keys/release.asc
gpgconf --homedir ${PWD}/gen --kill all >/dev/null 2>&1 || :
! keys | grep -q 'renewed@localhost' || false
qetuto -C
keys | grep -q 'renewed@localhost'
[[ $(kval ${fpr}) == f && $(stat -c %Y ${home}/.getuto.last) -eq ${before} ]]
tpass "a key file changed after the last run is imported the same day"
agents_down
touch home.good/.getuto.last

# if we don't have a passphrase of the local trust key, we can't sign
# anything.
# they key should return as unsigned, outputting a fail msg
rm -rf ${home}
cp -a home.good ${home}
gpg --homedir ${home} --batch --yes --delete-keys ${fpr} >/dev/null 2>&1
agents_down
rm -f ${home}/pass
set +e
err=$(qetuto -C 2>&1 >/dev/null)
rc=$?
set -e
keys | grep -q "^fpr:::::::::${fpr}:"
[[ ${rc} -ne 0 && ${err} == *"release key ${fpr} is not trusted"* ]]
[[ ${err} == *"and run qetuto again"* ]]
tpass "a release key that cannot be signed is reported"
agents_down

# a key file that someone other than its owner can change is not a
# source of trust. we won't import/sign it.
rm -rf ${home}
cp -a home.good ${home}
gpg --homedir ${home} --batch --yes --delete-keys ${fpr} >/dev/null 2>&1
agents_down
chmod 664 root/keys/release.asc
set +e
err=$(qetuto -C 2>&1 >/dev/null)
rc=$?
set -e
chmod 644 root/keys/release.asc
[[ ${rc} -ne 0 && ${err} == *"writable by group or others"* ]]
[[ -z $(kval ${fpr}) ]]
tpass "a key file writable by group or others is refused"
agents_down
touch home.good/.getuto.last

rm -rf ${home}
cp -a home.good ${home}
rm -f ${home}/pubring.kbx
set +e
err=$(qetuto -C 2>&1 >/dev/null)
rc=$?
set -e
[[ ${rc} -ne 0 && ${err} == *"no local trust key"* ]]
tpass "a lost local trust key is reported"
agents_down

rm -rf ${home}
cp -a home.good ${home}
head -c 1640 /dev/zero | tr '\0' '\377' > ${home}/trustdb.gpg
set +e
err=$(qetuto -C 2>&1 >/dev/null)
rc=$?
set -e
[[ ${rc} -ne 0 && ${err} == *"gpg cannot read the keyring"* ]]
[[ ${err} == *"and run qetuto again"* ]]
tpass "a keyring gpg cannot read is reported"
agents_down

rm -rf ${home}
cp -a home.good ${home}
qetuto -C
tpass "an intact keyring passes the keyring check"
agents_down

# QETUTO_NONFATAL=1, for q/emerge that stops on a failed trust helper
# (emerge does): whatever goes wrong with the keyring, qetuto says so
# and still ends with 0.
# we must check a problem the keyring check reports
gpg --homedir ${home} --batch --yes --delete-keys ${fpr} >/dev/null 2>&1
agents_down
rm -f ${home}/pass
set +e
err=$(QETUTO_NONFATAL=1 qetuto -C 2>&1 >/dev/null)
rc=$?
set -e
[[ ${rc} -eq 0 && ${err} == *"release key ${fpr} is not trusted"* ]]
[[ ${err} == *"keyring was not updated (exit code 1)"* ]]
[[ ${err} == *"continuing, signed binary packages may be refused"* ]]
tpass "QETUTO_NONFATAL: a reported keyring problem ends with 0"
agents_down

# the working process dies: gpg stand-in kills the process that
# started it
rm -rf ${home}
cp -a home.good ${home}
mkdir -p fakegpg
printf '#!/bin/sh\nkill -KILL $PPID\n' > fakegpg/gpg
chmod +x fakegpg/gpg
set +e
err=$(PATH=${PWD}/fakegpg:${PATH} QETUTO_NONFATAL=1 qetuto -C 2>&1 >/dev/null)
rc=$?
set -e
[[ ${rc} -eq 0 && ${err} == *"keyring was not updated (stopped by signal"* ]]
tpass "QETUTO_NONFATAL: a crash of the working process ends with 0"
agents_down

# the work never finishes: gpg stand-in that sleeps, and a short limit
printf '#!/bin/sh\nsleep 60\n' > fakegpg/gpg
SECONDS=0
set +e
err=$(PATH=${PWD}/fakegpg:${PATH} QETUTO_NONFATAL=1 QETUTO_TIMEOUT=2 \
	qetuto -C 2>&1 >/dev/null)
rc=$?
set -e
[[ ${rc} -eq 0 && ${err} == *"took longer than 2 seconds"* && ${SECONDS} -lt 20 ]]
tpass "QETUTO_NONFATAL: a run over QETUTO_TIMEOUT is stopped and ends with 0"
rm -rf fakegpg
agents_down

rm -rf ${home}
cp -a home.good ${home}

# we have to check if a broken keyring (or changed?) outputs a failure
# in the same manner as getuto.
# the last run timestamp file should not renewed when the refresh fails
cp ${home}/gpg.conf gpg.conf.good
echo bogus-option-xyz >> ${home}/gpg.conf
touch -d '2 days ago' ${home}/.getuto.last
before=$(stat -c %Y ${home}/.getuto.last)
set +e
qetuto -C >/dev/null 2>&1
rc=$?
set -e
cp gpg.conf.good ${home}/gpg.conf
[[ ${rc} -ne 0 && $(stat -c %Y ${home}/.getuto.last) -eq ${before} ]]
tpass "refresh with an invalid gpg.conf fails and keeps the old last run timestamp file"
agents_down

rm -f ${home}/trustdb.gpg
touch -d '2 days ago' ${home}/.getuto.last
set +e
err=$(qetuto -C 2>&1 >/dev/null)
rc=$?
set -e
[[ ${rc} -ne 0 && ${err} == *"trustdb.gpg"* ]]
tpass "refresh without trustdb.gpg fails"
agents_down

head -c 4096 /dev/zero | tr '\0' '\377' > ${home}/pubring.kbx
touch -d '2 days ago' ${home}/.getuto.last
before=$(stat -c %Y ${home}/.getuto.last)
set +e
qetuto -C >/dev/null 2>&1
rc=$?
set -e
[[ ${rc} -ne 0 && $(stat -c %Y ${home}/.getuto.last) -eq ${before} ]]
tpass "refresh with a damaged pubring.kbx fails and keeps the old last run timestamp file"
agents_down

# bootstrap without a release key file fails and leaves no staging dir
rm -rf ${home}
set +e
QETUTO_KEYS=/keys/missing.asc qetuto -C >/dev/null 2>&1
rc=$?
set -e
[[ ${rc} -ne 0 && ! -e ${home} && ! -e ${home}.getuto.tmp ]]
tpass "bootstrap without a release key fails cleanly"

# test wether we refuse a bootstrap from a keyring that gpg cannot read
chmod 664 root/keys/release.asc
set +e
err=$(qetuto -C 2>&1 >/dev/null)
rc=$?
set -e
chmod 644 root/keys/release.asc
[[ ${rc} -ne 0 && ${err} == *"writable by group or others"* ]]
[[ ! -e ${home} && ! -e ${home}.getuto.tmp ]]
tpass "bootstrap from a key file writable by group or others is refused"

# bootstrap without a working openssl fails and the staging should be removed
mkdir -p fakebin
printf '#!/bin/sh\nexit 1\n' > fakebin/openssl
chmod +x fakebin/openssl
set +e
err=$(PATH=${PWD}/fakebin:${PATH} qetuto -C 2>&1 >/dev/null)
rc=$?
set -e
[[ ${rc} -ne 0 && ${err} == *"could not generate a passphrase"* ]]
[[ ! -e ${home} && ! -e ${home}.getuto.tmp ]]
tpass "bootstrap without openssl fails cleanly"

if [[ ${EUID} -ne 0 ]] ; then
	chmod 500 root/etc/portage
	set +e
	err=$(qetuto -C 2>&1 >/dev/null)
	rc=$?
	set -e
	chmod 755 root/etc/portage
	[[ ${rc} -ne 0 && ${err} == *"cannot create"* && ! -e ${home} ]]
	tpass "bootstrap into an unwritable parent fails cleanly"

	# the real system keyring is root's business
	set +e
	err=$(qetuto --root / -C 2>&1 >/dev/null)
	rc=$?
	set -e
	[[ ${rc} -ne 0 && ${err} == *"must be run as root"* ]]
	tpass "ROOT=/ is refused without root"
fi

agents_down
gpgconf --kill all >/dev/null 2>&1 || :

cleantmpdir