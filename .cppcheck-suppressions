# cppcheck false positives, all verified by hand (no real bug behind any).
# The Code Sanity job runs cppcheck at its default (error) severity as a
# gate; these are the error-level findings it cannot prove safe on its own.

# root is only "uninitialized" when realpath() fails, but that branch calls
# errp() which never returns; cppcheck does not know errp is noreturn.
legacyUninitvar:main.c

# buf is xrealloc'd before buf+len every pass (first iter: len+BUFSIZ>cap is
# always true, len is 0), so buf is never NULL at the pointer add.
nullPointerArithmetic:qmerge.c

# p points at a local intbuf[4] that WRITE_BE_INT32 fills before fwrite reads
# it; cppcheck does not track the macro's stores into the buffer.
uninitvar:libq/xpak.c

# the make.conf variable table marks a BOOL default of "true" with the
# pointer value 1, the table's own convention.
# it is compared, not dereferenced.
intToPointerCast:main.c

# the two %s targets are halves of a buffer twice the size of the string
# being scanned, so no field can be longer than the buffer it lands in.
invalidscanf:qlop.c

# the summary lines use positional %N$ conversions. cppcheck maps the
# arguments by position in the list, so it pairs
# the size_t counts with the %s color strings and vice versa.
invalidPrintfArgType_s:qcheck.c
invalidPrintfArgType_uint:qcheck.c
